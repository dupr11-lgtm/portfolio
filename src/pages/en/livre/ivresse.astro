---
import Meta from "@/components/meta.astro";
import ThemeToggle from "@/components/theme-toggle.astro";
import LanguageToggle from "@/components/language-toggle.astro";
import { useTranslations } from "@/i18n/ui";

const t = useTranslations("en");
---

<html lang="en">
  <head>
    <Meta
      title="14 minutes et 16 heures | Aliénor du Parc"
      description={t("livre.description")}
      lang="en"
      alternates={{ fr: "/livre/ivresse", en: "/en/livre/ivresse" }}
    />
  </head>
  <body class="min-h-screen bg-[var(--bg)] text-[var(--fg)] antialiased">
    <main class="mx-auto flex min-h-screen w-full max-w-6xl flex-col px-6 py-8 md:px-10 md:py-10">
      <a href="/en/post/ivresse" class="mb-4 inline-block text-sm font-semibold underline underline-offset-4">
        {t("livre.back")}
      </a>
      <h1 class="font-title mb-4 text-4xl uppercase tracking-[0.06em] md:text-5xl">14 minutes et 16 heures</h1>
      <div class="h-[78vh] w-full overflow-hidden rounded-2xl border border-[var(--border-20)]">
        <iframe
          src="/projects/ivresse.mdx/14-minutes-et-16-heures.pdf"
          title="14 minutes et 16 heures"
          class="h-full w-full"
        ></iframe>
      </div>
    </main>
    <div class="theme-dock-fixed">
      <LanguageToggle lang="en" />
      <ThemeToggle />
    </div>
  </body>
</html>
