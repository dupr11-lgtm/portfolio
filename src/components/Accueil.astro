---
import Jour from "@/components/Jour.astro";
import Logo from "@/components/Logo.astro";
import { scriptEnLigne } from "@/data/scriptEnLigne";
import { accueil, esc, jeu, opt, pagesEn, prefixe, sourceTelephone, VEDETTE, type Lang } from "@/data/site";
import { BREF, FORMATION, traduction } from "@/i18n/ui";
import Base from "@/layouts/Base.astro";
import { disque } from "@/scripts/formes.js";
import { TELEPHONE } from "@/scripts/reglages.js";
import "@/styles/accueil.css";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = traduction(lang);
const PAGES = pagesEn(lang);

// i : projet / col, span, row, ar, mt : place sur le plan / disc : [taille, x, y] qui dépasse derrière l'image
const G: [string, any[]][] = [
  ["2026", [
    { i: 14, col: 2, span: 4, row: 2, ar: "1/1" },
    { i: 15, col: 7, span: 4, row: 2, ar: "1/1", mt: 90 },
  ]],
  ["2025", [
    { i: 0, col: 1, span: 7, row: 2, ar: "16/10", disc: [22, 84, -12] },
    { i: 1, col: 9, span: 4, row: 2, ar: "1/1", mt: 150, bright: 2.6 },
    { i: 2, col: 3, span: 5, row: 3, ar: "4/3" },
  ]],
  ["2024", [
    { i: 5, col: 4, span: 9, row: 2, ar: "16/9", disc: [20, -7, 62], dbleu: 1 },
  ]],
  ["2023", [
    { i: 3, col: 1, span: 5, row: 2, ar: "4/3", disc: [34, 76, -14] },
    { i: 4, col: 6, span: 7, row: 2, ar: "16/10", mt: 110 },
    { i: 6, col: 2, span: 3, row: 3, ar: "4/5", disc: [46, -16, 48], dbleu: 1 },
    { i: 7, col: 6, span: 7, row: 3, ar: "16/9", mt: 70 },
    { i: 8, col: 1, span: 7, row: 4, ar: "16/10" },
    { i: 9, col: 9, span: 4, row: 4, ar: "1/1", mt: 130, disc: [40, 70, 84] },
    { i: 10, col: 2, span: 5, row: 5, ar: "4/3" },
    { i: 11, col: 8, span: 4, row: 5, ar: "1/1", mt: 60 },
    { i: 12, col: 3, span: 8, row: 6, ar: "16/9", disc: [18, 91, -8] },
  ]],
  ["2021", [
    { i: 13, col: 5, span: 6, row: 2, ar: "3/2" },
  ]],
];

// Chaque disque est découpé à la main, façon ciseaux : sa graine suit son ordre dans la page
let graine = 0;
const d = (style: string, bleu = false) => `<div class="d" style="${style}">${disque(graine++, bleu)}</div>`;
const heroDisques = d("width:19vw;height:19vw;left:66%;top:1%").replace('class="d"', 'class="d gros"') + d("width:4.6vw;height:4.6vw;left:27%;top:26%", true) + d("width:2.2vw;height:2.2vw;left:33%;top:15%").replace('class="d"', 'class="d point"');

let n = 0, fil = "", table = "";
for (const [an, items] of G) {
  fil += `<li class="an">${an}</li>`;
  table += `<section class="annee" id="a${an}"><h2>${an}</h2>`;
  for (const q of items) {
    const P = PAGES.find((x) => x.i == q.i), no = String(++n).padStart(2, "0"), id = "p" + no, pre = P.cover?.brut ? "filter:none" : q.bright ? `--pre:brightness(${q.bright})` : "";
    // La couverture du projet se prépare au survol, avec les mêmes tailles que sur sa page
    const vedette = P.dossier != "ivresse" && !P.lien && P.cover ? ` data-jeu="${jeu(P.cover.s)}" data-tailles="${VEDETTE}"` : "";
    fil += `<li><a href="#${id}" data-p="${id}"><i>${esc(P.court)}</i>${no}</a></li>`;
    table += `<a class="it" id="${id}" href="${P.url}"${vedette} style="grid-column:${q.col}/span ${q.span};grid-row:${q.row};margin-top:${q.mt || 0}px"><div class="cad">
      ${q.disc ? d(`width:${q.disc[0]}%;aspect-ratio:1;left:${q.disc[1]}%;top:${q.disc[2]}%`, !!q.dbleu) : ""}
      ${P.couverture ? `<div class="pl" style="aspect-ratio:${q.ar}"><picture>${sourceTelephone(P.couverture, "90vw")}<img class="im" loading="lazy" decoding="async" src="${opt(P.couverture, 800)}" srcset="${jeu(P.couverture)}" sizes="(max-width:900px) 90vw,${Math.round(q.span / .12)}vw" alt="${esc(P.titre)}" style="${pre}"></picture></div>` : `<div class="vide" style="position:relative;z-index:1">${q.vide || t("duree")}</div>`}
      </div>
      <div class="bas"><div class="cap"><b>${no}</b><div style="grid-column:2"><h3>${esc(P.titre)}</h3><p>${esc(P.an)} - ${esc(P.meta)}</p></div></div>${P.note ? `<p class="note">${esc(P.note)}</p>` : ""}</div></a>`;
  }
  table += "</section>";
}
const contactDisque = d("width:11vw;height:11vw;right:calc(13rem + 39%);top:10%");
const racine = accueil(lang);
const carte = "/projects/centre-de-recherches.mdx/cover.jpg", carte800 = opt(carte, 800), carte1200 = opt(carte, 1200), carte1600 = opt(carte, 1600);
---

<Base title="Aliénor du Parc" description={t("description")} lang={lang} chemin="/" attributs={{ "data-im": "bleu", "data-logo-c": "b" }}>
  <Fragment slot="tete">
    {lang === "fr" && (
      <script is:inline>(function(){var s=null;try{s=localStorage.getItem("lang")}catch(e){}var n=(navigator.languages&&navigator.languages[0])||navigator.language||"";if(!/bot|crawl|spider|slurp/i.test(navigator.userAgent)&&(s==="en"||(s!=="fr"&&!/^fr/i.test(n))))location.replace("/en"+location.search+location.hash)})()</script>
    )}
    <script is:inline>(function(){try{var n=performance.getEntriesByType("navigation")[0];if(n&&n.type=="back_forward"&&sessionStorage.getItem("retour")){history.scrollRestoration="manual";document.documentElement.classList.add("retour")}}catch(e){}})()</script>
    <link rel="preload" as="image" media={`not all and ${TELEPHONE}`} href={carte1600} />
    <link rel="preload" as="image" media={TELEPHONE} href={carte800} />
  </Fragment>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <filter id="bleu" color-interpolation-filters="sRGB"><feColorMatrix type="saturate" values="0"></feColorMatrix><feComponentTransfer><feFuncR type="linear" slope="1.3" intercept="-.13"></feFuncR><feFuncG type="linear" slope="1.3" intercept="-.13"></feFuncG><feFuncB type="linear" slope="1.3" intercept="-.13"></feFuncB></feComponentTransfer><feComponentTransfer><feFuncR type="table" tableValues=".145 .937"></feFuncR><feFuncG type="table" tableValues=".17 .914"></feFuncG><feFuncB type="table" tableValues=".5 .867"></feFuncB></feComponentTransfer></filter>
    <filter id="nuit-sable" color-interpolation-filters="sRGB"><feColorMatrix type="saturate" values="0"></feColorMatrix><feComponentTransfer><feFuncR type="table" tableValues=".078 .36 .78"></feFuncR><feFuncG type="table" tableValues=".086 .35 .74"></feFuncG><feFuncB type="table" tableValues=".18 .36 .65"></feFuncB></feComponentTransfer></filter>
  </svg>

  <a class="haut gauche" id="logo" data-logo href={racine} aria-label={t("accueil")}><Logo /><span>Aliénor<br />du Parc</span></a>
  <nav class="haut droite"><a href="#a2026">{t("portfolio")}</a><a href="#profil">{t("profil")}</a><a href="#contact">{t("contact")}</a></nav>
  <ol class="fil" id="fil" set:html={fil}></ol>
  <Jour lang={lang} chemin="/" />

  <div id="page">
    <div id="champ" aria-hidden="true"></div>
    <svg id="couche" aria-hidden="true"><g id="gras" fill="none" stroke-linecap="round" style="stroke:var(--r)"></g></svg>
    <section class="hero">
      <Fragment set:html={heroDisques} />
      <div class="carte im" id="carte" data-net={carte1200} style={`--carte:url(${carte1600});--carte-tel:url(${carte800})`}></div>
      <h1>Aliénor<br />du Parc</h1>
      <p class="sous">{t("hero")}</p>
    </section>
    <main id="table" set:html={table}></main>
    <section class="profil" id="profil">
      <h2 class="titre">{t("profil")}</h2>
      <div class="bloc bref"><h3>{t("enbref")}</h3><p set:html={BREF[lang]}></p></div>
      <dl class="bloc form" id="formation">
        <h3>{t("formation")}</h3>
        {FORMATION[lang].map(([date, lignes]) => (
          <>
            <dt>{date}</dt>
            <dd set:html={lignes.join("<br>")}></dd>
          </>
        ))}
      </dl>
    </section>
    <section class="contact" id="contact">
      <Fragment set:html={contactDisque} />
      <div class="fin" id="fin"><a data-logo href={racine} aria-label="Aliénor du Parc"><Logo /></a></div>
      <h2>{t("contact")}</h2>
      <a class="mail" href="mailto:alienor@duparc.studio">alienor@duparc.studio</a>
    </section>
  </div>
  <script is:inline set:html={scriptEnLigne("accueil.js")}></script>
</Base>
