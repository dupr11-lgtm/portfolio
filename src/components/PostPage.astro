---
import type { CollectionEntry } from "astro:content";
import Meta from "@/components/meta.astro";
import ThemeToggle from "@/components/theme-toggle.astro";
import LanguageToggle from "@/components/language-toggle.astro";
import { useTranslations, type Lang } from "@/i18n/ui";
import { StarIcon } from "@lucide/astro";
import fs from "node:fs";
import path from "node:path";

interface Props {
    post: CollectionEntry<"posts"> | CollectionEntry<"postsEn">;
    lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);

const projectsRoot = path.join(process.cwd(), "public", "projects");
const imageExt = new Set([".png", ".jpg", ".jpeg", ".webp", ".svg"]);

const norm = (value: string) =>
    value
        .normalize("NFD")
        .replace(/\p{M}/gu, "")
        .replace(/\.mdx?$/i, "")
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, " ")
        .trim();

const projectDirs = fs.existsSync(projectsRoot)
    ? fs.readdirSync(projectsRoot, { withFileTypes: true }).filter((d) => d.isDirectory()).map((d) => d.name)
    : [];

const dirName =
    projectDirs.find((dir) => {
        const key = norm(dir);
        return key === norm(post.data.title) || key === norm(post.slug);
    }) ?? null;

const postImages = dirName
    ? fs
          .readdirSync(path.join(projectsRoot, dirName))
          .filter((f) => imageExt.has(path.extname(f).toLowerCase()))
          .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: "base" }))
    : [];

const preferredPostCoverBySlug = new Map<string, string>([["nakagin-capsule", "cover2.jpeg"]]);
const coverExclusionsBySlug = new Map<string, string[]>([
    ["nakagin-capsule", ["cover.jpg"]],
    ["podcast", ["Miniature officielle.png", "Miniature officielle.jpg", "Miniature officielle.jpeg", "Miniatureofficielle.png", "profil.png", "profil.jpg", "profil.jpeg"]],
]);

const preferredPostCover = preferredPostCoverBySlug.get(post.slug);
const coverImage =
    (preferredPostCover && postImages.includes(preferredPostCover) && preferredPostCover) ||
    postImages.find((f) => /^cover\./i.test(f)) ||
    null;
const excluded = new Set<string>([coverImage ?? "", ...(coverExclusionsBySlug.get(post.slug) ?? [])]);
const galleryImages = postImages.filter((f) => {
    if (excluded.has(f)) return false;
    if (post.slug === "podcast" && /miniature\s*officielle/i.test(f)) return false;
    return true;
});

const imagePositionByPost = new Map<string, Map<string, string>>([
    ["entre-deux-corps", new Map([["3.png", "50% 64%"]])],
    [
        "structure-beton",
        new Map([
            ["cover.jpg", "50% 62%"],
            ["1.jpg", "50% 62%"],
            ["2.jpg", "50% 62%"],
            ["3.jpg", "50% 62%"],
            ["4.jpg", "50% 62%"],
        ]),
    ],
    ["32-logements", new Map([["3.jpg", "50% 64%"]])],
    ["centre-de-recherches", new Map([["3.jpg", "50% 58%"]])],
    ["ecole-sad", new Map([["cover.jpg", "50% 64%"]])],
    ["nakagin-capsule", new Map([["2.png", "50% 0%"]])],
    ["stage-simon-1", new Map([["cover.png", "50% 82%"]])],
    ["stage-chantier", new Map([["2.png", "40% 36%"]])],
]);

const imageTransformByPost = new Map<string, Map<string, string>>();

const getImagePosition = (fileName: string) =>
    imagePositionByPost.get(post.slug)?.get(fileName) ?? "50% 50%";

const getImageTransform = (fileName: string) =>
    imageTransformByPost.get(post.slug)?.get(fileName) ?? "";

const isFestivalPost = post.slug === "festival--structure-temporaire";
const findFestivalImage = (index: string) =>
    galleryImages.find((image) => image.startsWith(`${index}.`)) ?? null;
const festivalMosaicLeft = findFestivalImage("3");
const festivalMosaicRight = [findFestivalImage("4"), findFestivalImage("5"), findFestivalImage("6")].filter(
    (image): image is string => Boolean(image),
);
const festivalMosaicSet = new Set<string>([
    ...(festivalMosaicLeft ? [festivalMosaicLeft] : []),
    ...festivalMosaicRight,
]);
const festivalRegularImages = isFestivalPost
    ? galleryImages.filter((image) => !festivalMosaicSet.has(image))
    : galleryImages;
const hasFestivalMosaic =
    isFestivalPost &&
    Boolean(festivalMosaicLeft) &&
    festivalMosaicRight.length > 0;

const isOriginalFormatImage = (fileName: string) =>
    (post.slug === "festival--structure-temporaire" && fileName === festivalMosaicLeft) ||
    (post.slug === "nakagin-capsule" && fileName === "2.png") ||
    (post.slug === "centre-de-recherches" && fileName === "3.jpg");

const isTopAlignedOriginalImage = (fileName: string) =>
    post.slug === "nakagin-capsule" && fileName === "2.png";

const blueFilledStarSlugs = new Set([
    "entre-deux-corps",
    "podcast",
    "festival--structure-temporaire",
    "chatel",
]);
const isBlueFilledStarProject = blueFilledStarSlugs.has(post.slug) || post.slug === "ivresse";

const toImageUrl = (fileName: string) => {
    const base = `/projects/${encodeURIComponent(dirName ?? "")}/${encodeURIComponent(fileName)}`;
    if (!dirName) return base;
    const fullPath = path.join(projectsRoot, dirName, fileName);
    if (!fs.existsSync(fullPath)) return base;
    const version = fs.statSync(fullPath).mtimeMs.toFixed(0);
    return `${base}?v=${version}`;
};

const podcastAudioCandidates = ["podcats.mp3", "podcast.mp3"];
const podcastAudioFile =
    post.slug === "podcast" && dirName
        ? podcastAudioCandidates.find((name) => fs.existsSync(path.join(projectsRoot, dirName, name))) ?? null
        : null;
const podcastAudioUrl = podcastAudioFile ? toImageUrl(podcastAudioFile) : null;
const podcastThumbCandidates = [
    "profil.png",
    "profil.jpg",
    "profil.jpeg",
    "Miniature officielle.png",
    "Miniature officielle.jpg",
    "Miniature officielle.jpeg",
    "Miniatureofficielle.png",
];
const podcastThumbFile =
    post.slug === "podcast" && dirName
        ? podcastThumbCandidates.find((name) => fs.existsSync(path.join(projectsRoot, dirName, name))) ||
          postImages.find((name) => /^profil\./i.test(name)) ||
          postImages.find((name) => /miniature\s*officielle/i.test(name)) ||
          null
        : null;
const podcastThumbUrl = podcastThumbFile ? toImageUrl(podcastThumbFile) : null;

const popColors = ["yellow", "pink", "cyan", "red"] as const;
const metaTags = post.data.description
    .replace(/\.$/, "")
    .split(" - ")
    .map((part) => part.trim())
    .filter(Boolean);

const frPath = `/post/${post.slug}`;
const enPath = `/en/post/${post.slug}`;

const { Content } = await post.render();
---

<html lang={lang}>
    <head>
        <Meta
            title={`${post.data.title} | Aliénor du Parc`}
            description={post.data.description}
            slug={coverImage && dirName ? `/projects/${encodeURIComponent(dirName)}/${encodeURIComponent(coverImage)}` : undefined}
            lang={lang}
            alternates={{ fr: frPath, en: enPath }}
        />
    </head>
    <body class="font-body bg-[var(--bg)] text-[var(--fg)] antialiased">
        <main
            class="w-full mx-auto max-w-6xl px-6 py-10 md:px-12 md:py-14 flex flex-col space-y-12"
        >
            <a
                href={lang === "en" ? "/en" : "/"}
                class="inline-flex items-center"
            >
                <img src="/favicon1.svg" alt="Logo Aliénor" class="logo-light h-10 w-10 object-contain md:h-12 md:w-12" />
            </a>
            <div class="w-full flex flex-col space-y-10">
                <div class="w-full flex flex-col space-y-6 pb-4">
                    <h1 class="font-title max-w-5xl text-5xl leading-[0.9] text-[var(--fg)] md:text-8xl">
                        {post.data.title}
                    </h1>
                    {
                        post.slug === "podcast" && (
                            <p class="font-script text-3xl text-[var(--fg-85)] md:text-4xl">
                                Double Vision : Architecture Abroad
                            </p>
                        )
                    }
                    {
                        post.slug === "ivresse" && (
                            <p class="font-script text-3xl text-[var(--accent)] md:text-4xl">
                                <a
                                    href={lang === "en" ? "/en/livre/ivresse" : "/livre/ivresse"}
                                    class="inline-flex items-center gap-1"
                                >
                                    <span class="underline underline-offset-4">14 minutes et 16 heures</span>
                                    <span aria-hidden="true">↗</span>
                                </a>
                            </p>
                        )
                    }
                    <div class="flex items-center justify-between">
                        <div
                            class="flex items-center flex-wrap gap-y-2 text-sm text-[var(--fg-80)] md:text-base"
                        >
                            <span class="flex flex-wrap items-center gap-2">
                                {metaTags.map((tag, index) => (
                                    <span class={`sticker sticker-${popColors[index % popColors.length]} ${index % 2 ? "rotate-1" : "-rotate-1"}`}>{tag}</span>
                                ))}
                            </span>
                            {
                                post.data.contributors.length > 0 && (
                                    <>
                                        <span>&nbsp;{t("post.with")}&nbsp;</span>
                                        {post.data.contributors.map(
                                            (contributor, index) => (
                                                <>
                                                    <address class="whitespace-nowrap not-italic underline">
                                                        <a
                                                         href={`${contributor.url}?ref=duparc.studio`}
                                                            target="_blank"
                                                            rel="noopener noreferrer"
                                                        >
                                                            {contributor.name}
                                                        </a>
                                                    </address>
                                                    {index <
                                                        post.data.contributors
                                                            .length -
                                                            2 && (
                                                        <span>,&nbsp;</span>
                                                    )}
                                                    {index ===
                                                        post.data.contributors
                                                            .length -
                                                            2 && (
                                                        <span>&nbsp;{t("post.and")}&nbsp;</span>
                                                    )}
                                                </>
                                            ),
                                        )}
                                    </>
                                )
                            }
                        </div>
                        <div class="flex items-center">
                            <StarIcon width={18} height={18} class={isBlueFilledStarProject ? "fill-[var(--fg)] stroke-[var(--fg)]" : "stroke-[var(--fg)]"} />
                        </div>
                    </div>
                </div>
                {
                    coverImage && (
                        <img
                            src={toImageUrl(coverImage)}
                            alt={`${post.data.title} ${t("post.coverAlt")}`}
                            class="post-image post-media rounded-[1.75rem] cursor-zoom-in"
                            style={`object-position: ${getImagePosition(coverImage)};`}
                        />
                    )
                }
                {
                    post.slug === "podcast" && podcastAudioUrl && (
                        <section id="podcast-panel" class="podcast-panel rounded-[1.75rem] border border-[var(--border-20)] px-3 py-2 md:px-4 md:py-2.5">
                            <audio id="podcast-audio" src={podcastAudioUrl} preload="auto"></audio>
                            <div class="relative flex items-center justify-between gap-3 text-[10px] font-semibold uppercase tracking-[0.08em] text-[var(--fg-70)]">
                                <div class="flex min-w-0 items-center gap-2 pr-10">
                                    {
                                        podcastThumbUrl && (
                                            <img
                                                src={podcastThumbUrl}
                                                alt={t("post.podcast.artwork")}
                                                class="h-7 w-7 rounded object-cover"
                                            />
                                        )
                                    }
                                </div>
                                <button
                                    id="podcast-toggle"
                                    class="absolute left-1/2 top-1/2 inline-flex h-8 w-8 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-[var(--panel-active-bg)] text-[11px] leading-none text-[var(--panel-active-fg)]"
                                    aria-label={t("post.podcast.playPause")}
                                >
                                    ▶
                                </button>
                                <span class="pl-10 text-right leading-tight">Aliénor Knoll<br />&amp; Aliénor du Parc</span>
                            </div>
                            <div class="mt-1.5">
                                <div class="podcast-track-hit w-full">
                                    <input
                                        id="podcast-seek"
                                        type="range"
                                        min="0"
                                        max="1000"
                                        value="0"
                                        step="1"
                                        class="podcast-seek"
                                        aria-label={t("post.podcast.seek")}
                                    />
                                </div>
                                <div class="mt-1.5 flex items-center justify-between text-[11px] font-semibold text-[var(--fg-80)]">
                                    <span id="podcast-current">00:00</span>
                                    <span id="podcast-duration">00:00</span>
                                </div>
                                <p
                                    id="podcast-status"
                                    class="mt-1 hidden text-[11px] font-semibold text-[var(--fg-70)]"
                                    data-msg-default={t("post.podcast.status")}
                                    data-msg-blocked={t("post.podcast.blocked")}
                                    data-msg-error={t("post.podcast.error")}
                                >
                                    {t("post.podcast.status")}
                                </p>
                            </div>
                        </section>
                    )
                }
                <article
                    class="post-body prose prose-invert prose-pre:max-h-[600px] max-w-2xl"
                >
                    <Content />
                </article>
                {
                    festivalRegularImages.length > 0 && (
                        <section class="grid grid-cols-1 gap-4">
                            {festivalRegularImages.map((image) => (
                                <img
                                    src={toImageUrl(image)}
                                    alt={`${post.data.title} image`}
                                    class={`post-image post-media rounded-[1.75rem] cursor-zoom-in ${isOriginalFormatImage(image) ? "post-media-original" : ""} ${isTopAlignedOriginalImage(image) ? "post-media-original-top" : ""}`}
                                    style={`object-position: ${getImagePosition(image)};${getImageTransform(image) ? ` transform: ${getImageTransform(image)};` : ""}`}
                                    loading="lazy"
                                />
                            ))}
                        </section>
                    )
                }
                {
                    hasFestivalMosaic && (
                        <section class="grid grid-cols-1 gap-4 md:grid-cols-2">
                            <div class="festival-half-frame rounded-[1.75rem]">
                                <img
                                    src={toImageUrl(festivalMosaicLeft ?? "")}
                                    alt={`${post.data.title} image`}
                                    class="post-image festival-half-image festival-half-left cursor-zoom-in"
                                    loading="lazy"
                                />
                            </div>
                            <div class="grid grid-cols-1 gap-4">
                                {festivalMosaicRight.map((image) => (
                                    <div class="festival-half-frame rounded-[1.75rem]">
                                        <img
                                            src={toImageUrl(image)}
                                            alt={`${post.data.title} image`}
                                            class="post-image festival-half-image festival-half-right cursor-zoom-in"
                                            loading="lazy"
                                        />
                                    </div>
                                ))}
                            </div>
                        </section>
                    )
                }
            </div>
        </main>
        <div class="theme-dock-fixed">
            <LanguageToggle lang={lang} />
            <ThemeToggle />
        </div>
        <div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-[var(--bg-95)] p-4 md:p-6">
            <button id="lightbox-prev" class="absolute left-2 top-1/2 z-20 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-[var(--bg-85)] text-4xl leading-none text-[var(--fg-95)] md:left-5 md:h-auto md:w-auto md:rounded-none md:bg-transparent md:text-5xl" aria-label={t("post.lightbox.prev")}>&#8249;</button>
            <button id="lightbox-close" class="absolute right-3 top-3 z-20 inline-flex h-9 w-9 items-center justify-center rounded-full bg-[var(--bg-85)] text-3xl leading-none text-[var(--fg)] md:right-5 md:top-4 md:h-auto md:w-auto md:rounded-none md:bg-transparent md:text-4xl" aria-label={t("post.lightbox.close")}>&times;</button>
            <button id="lightbox-rotate" class="absolute right-14 top-3 z-20 inline-flex h-9 w-9 items-center justify-center rounded-full bg-[var(--bg-85)] text-2xl leading-none text-[var(--fg-90)] md:right-16 md:top-4 md:h-auto md:w-auto md:rounded-none md:bg-transparent md:text-3xl" aria-label={t("post.lightbox.rotate")}>&#8635;</button>
            <button id="lightbox-next" class="absolute right-2 top-1/2 z-20 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-[var(--bg-85)] text-4xl leading-none text-[var(--fg-95)] md:right-5 md:h-auto md:w-auto md:rounded-none md:bg-transparent md:text-5xl" aria-label={t("post.lightbox.next")}>&#8250;</button>
            <img id="lightbox-image" src="" alt={t("post.lightbox.image")} class="max-h-[92vh] max-w-[92vw] object-contain" />
        </div>
        <script>
            const images = Array.from(document.querySelectorAll<HTMLImageElement>(".post-image, article img"));
            const lightbox = document.getElementById("lightbox");
            const lightboxImage = document.getElementById("lightbox-image") as HTMLImageElement | null;
            const closeBtn = document.getElementById("lightbox-close");
            const rotateBtn = document.getElementById("lightbox-rotate");
            const prevBtn = document.getElementById("lightbox-prev");
            const nextBtn = document.getElementById("lightbox-next");
            let currentIndex = 0;
            let rotationDeg = 0;

            const podcastAudio = document.getElementById("podcast-audio") as HTMLAudioElement | null;
            const podcastPanel = document.getElementById("podcast-panel");
            const podcastToggle = document.getElementById("podcast-toggle");
            const podcastSeek = document.getElementById("podcast-seek") as HTMLInputElement | null;
            const podcastCurrent = document.getElementById("podcast-current");
            const podcastDuration = document.getElementById("podcast-duration");
            const podcastStatus = document.getElementById("podcast-status");
            let metadataReady = false;
            let pendingSeekRatio: number | null = null;

            const applyPendingSeek = () => {
                if (!podcastAudio) return;
                if (pendingSeekRatio === null) return;
                if (!Number.isFinite(podcastAudio.duration) || podcastAudio.duration <= 0) return;
                podcastAudio.currentTime = pendingSeekRatio * podcastAudio.duration;
                pendingSeekRatio = null;
            };

            const setToggleLoading = (isLoading: boolean) => {
                if (!podcastToggle) return;
                if (isLoading) {
                    podcastToggle.textContent = "◌";
                    podcastToggle.classList.add("is-loading");
                } else {
                    podcastToggle.classList.remove("is-loading");
                    if (podcastAudio) {
                        podcastToggle.textContent = podcastAudio.paused ? "▶" : "❚❚";
                    }
                }
            };

            const formatTime = (seconds: number) => {
                if (!Number.isFinite(seconds)) return "00:00";
                const total = Math.max(0, Math.floor(seconds));
                const mins = Math.floor(total / 60)
                    .toString()
                    .padStart(2, "0");
                const secs = (total % 60).toString().padStart(2, "0");
                return `${mins}:${secs}`;
            };

            const syncPodcastUi = () => {
                if (!podcastAudio) return;
                const hasDuration = Number.isFinite(podcastAudio.duration) && podcastAudio.duration > 0;
                if (hasDuration && !metadataReady) {
                    metadataReady = true;
                    setToggleLoading(false);
                }
                const ratio =
                    podcastAudio.duration > 0
                        ? (podcastAudio.currentTime / podcastAudio.duration) * 100
                        : 0;
                const clampedRatio = Math.min(100, Math.max(0, ratio));
                if (podcastSeek) {
                    podcastSeek.value = String(Math.round((clampedRatio / 100) * 1000));
                    podcastSeek.style.setProperty("--podcast-progress", `${clampedRatio}%`);
                }
                if (podcastCurrent) podcastCurrent.textContent = formatTime(podcastAudio.currentTime);
                if (podcastDuration) podcastDuration.textContent = formatTime(podcastAudio.duration);
                if (podcastToggle && !podcastToggle.classList.contains("is-loading")) {
                    podcastToggle.textContent = podcastAudio.paused ? "▶" : "❚❚";
                }
                if (podcastPanel) podcastPanel.classList.toggle("is-active", !podcastAudio.paused);
                if (podcastStatus && !podcastAudio.paused) podcastStatus.classList.add("hidden");
            };

            podcastToggle?.addEventListener("click", () => {
                if (!podcastAudio) return;
                if (podcastAudio.paused) {
                    podcastAudio.play().catch(() => {
                        if (podcastStatus) {
                            podcastStatus.textContent = podcastStatus.dataset.msgBlocked || "";
                            podcastStatus.classList.remove("hidden");
                        }
                    });
                } else {
                    podcastAudio.pause();
                }
            });

            const seekFromRange = () => {
                if (!podcastAudio) return;
                if (!podcastSeek) return;
                const ratio = Math.min(1, Math.max(0, Number(podcastSeek.value) / 1000));
                podcastSeek.style.setProperty("--podcast-progress", `${ratio * 100}%`);

                const hasDuration = Number.isFinite(podcastAudio.duration) && podcastAudio.duration > 0;
                if (!hasDuration) {
                    pendingSeekRatio = ratio;
                    return;
                }

                podcastAudio.currentTime = ratio * podcastAudio.duration;
                pendingSeekRatio = null;
                syncPodcastUi();
            };

            podcastSeek?.addEventListener("input", seekFromRange);
            podcastSeek?.addEventListener("change", seekFromRange);

            podcastAudio?.addEventListener("loadedmetadata", syncPodcastUi);
            podcastAudio?.addEventListener("loadedmetadata", () => {
                applyPendingSeek();
                syncPodcastUi();
            });
            podcastAudio?.addEventListener("canplay", syncPodcastUi);
            podcastAudio?.addEventListener("timeupdate", syncPodcastUi);
            podcastAudio?.addEventListener("play", syncPodcastUi);
            podcastAudio?.addEventListener("pause", syncPodcastUi);
            podcastAudio?.addEventListener("ended", syncPodcastUi);
            podcastAudio?.addEventListener("error", () => {
                if (podcastStatus) {
                    podcastStatus.textContent = podcastStatus.dataset.msgError || "";
                    podcastStatus.classList.remove("hidden");
                }
                setToggleLoading(false);
            });
            podcastAudio?.addEventListener("play", () => {
                if (podcastStatus) podcastStatus.classList.add("hidden");
            });

            setToggleLoading(true);

            const applyRotation = () => {
                if (!lightboxImage) return;
                lightboxImage.style.transform = `rotate(${rotationDeg}deg)`;
            };

            const openAt = (index: number) => {
                if (!lightboxImage || images.length === 0) return;
                currentIndex = (index + images.length) % images.length;
                const img = images[currentIndex];
                lightboxImage.src = img.currentSrc || img.src;
                lightboxImage.alt = img.alt || lightboxImage.alt;
                rotationDeg = 0;
                applyRotation();
                lightbox?.classList.remove("hidden");
                lightbox?.classList.add("flex");
            };

            const closeLightbox = () => {
                lightbox?.classList.add("hidden");
                lightbox?.classList.remove("flex");
                rotationDeg = 0;
                applyRotation();
            };

            const showPrev = () => openAt(currentIndex - 1);
            const showNext = () => openAt(currentIndex + 1);
            const rotateImage = () => {
                rotationDeg = (rotationDeg + 90) % 360;
                applyRotation();
            };

            images.forEach((img, index) => {
                img.classList.add("cursor-zoom-in");
                img.addEventListener("click", () => openAt(index));
            });

            closeBtn?.addEventListener("click", closeLightbox);
            rotateBtn?.addEventListener("click", (event) => {
                event.stopPropagation();
                rotateImage();
            });
            prevBtn?.addEventListener("click", (event) => {
                event.stopPropagation();
                showPrev();
            });
            nextBtn?.addEventListener("click", (event) => {
                event.stopPropagation();
                showNext();
            });
            lightbox?.addEventListener("click", (event) => {
                if (event.target === lightbox) closeLightbox();
            });
            window.addEventListener("keydown", (event) => {
                if (event.key === "Escape") closeLightbox();
                if (event.key === "ArrowLeft") showPrev();
                if (event.key === "ArrowRight") showNext();
                if (event.key.toLowerCase() === "r") rotateImage();
            });
        </script>
        <style>
            .logo-light {
                filter: var(--logo-filter);
            }

            :global(.prose),
            :global(.prose p),
            :global(.prose li),
            :global(.prose h1),
            :global(.prose h2),
            :global(.prose h3),
            :global(.prose h4) {
                color: var(--fg);
            }

            :global(.prose a) {
                color: var(--fg);
            }

            .post-media,
            :global(.prose img) {
                display: block;
                width: 100%;
                height: 70vh;
                max-height: 70vh;
                object-fit: cover;
                object-position: center;
            }

            .post-media-original {
                height: auto;
                max-height: none;
                object-fit: contain;
            }

            .post-media-original-top {
                height: 70vh;
                max-height: 70vh;
                width: 100%;
                object-fit: contain;
                object-position: top center;
                transform: scale(1.85) translateY(-12%);
                transform-origin: top center;
            }

            .podcast-panel {
                background-color: var(--panel-bg);
                transition: background-color 180ms ease;
            }

            .podcast-panel:hover,
            .podcast-panel.is-active {
                background-color: var(--panel-active-bg);
            }

            .podcast-panel:hover,
            .podcast-panel:hover #podcast-current,
            .podcast-panel:hover #podcast-duration,
            .podcast-panel:hover span,
            .podcast-panel.is-active,
            .podcast-panel.is-active #podcast-current,
            .podcast-panel.is-active #podcast-duration,
            .podcast-panel.is-active span {
                color: var(--panel-active-fg);
            }

            .podcast-seek {
                --podcast-progress: 0%;
                -webkit-appearance: none;
                appearance: none;
                width: 100%;
                height: 18px;
                background: transparent;
                margin: 0;
            }

            .podcast-seek::-webkit-slider-runnable-track {
                height: 4px;
                background: linear-gradient(
                    to right,
                    var(--track-filled) 0%,
                    var(--track-filled) var(--podcast-progress),
                    var(--track-empty) var(--podcast-progress),
                    var(--track-empty) 100%
                );
                border-radius: 999px;
            }

            .podcast-seek::-moz-range-track {
                height: 4px;
                background: linear-gradient(
                    to right,
                    var(--track-filled) 0%,
                    var(--track-filled) var(--podcast-progress),
                    var(--track-empty) var(--podcast-progress),
                    var(--track-empty) 100%
                );
                border-radius: 999px;
            }

            .podcast-seek::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                width: 12px;
                height: 12px;
                border-radius: 999px;
                margin-top: -4px;
                opacity: 0;
                border: 0;
            }

            .podcast-seek::-moz-range-thumb {
                width: 12px;
                height: 12px;
                border-radius: 999px;
                opacity: 0;
                border: 0;
            }

            .podcast-panel:hover .podcast-seek::-webkit-slider-runnable-track,
            .podcast-panel.is-active .podcast-seek::-webkit-slider-runnable-track {
                background: linear-gradient(
                    to right,
                    var(--track-filled-active) 0%,
                    var(--track-filled-active) var(--podcast-progress),
                    var(--track-empty-active) var(--podcast-progress),
                    var(--track-empty-active) 100%
                );
            }

            .podcast-panel:hover .podcast-seek::-moz-range-track,
            .podcast-panel.is-active .podcast-seek::-moz-range-track {
                background: linear-gradient(
                    to right,
                    var(--track-filled-active) 0%,
                    var(--track-filled-active) var(--podcast-progress),
                    var(--track-empty-active) var(--podcast-progress),
                    var(--track-empty-active) 100%
                );
            }

            .podcast-panel:hover #podcast-toggle {
                background-color: var(--panel-active-fg);
                color: var(--panel-active-bg);
            }

            .podcast-panel.is-active #podcast-toggle {
                background-color: var(--panel-active-fg);
                color: var(--panel-active-bg);
            }

            #podcast-toggle.is-loading {
                animation: podcastSpin 850ms linear infinite;
            }

            @keyframes podcastSpin {
                from { transform: translate(-50%, -50%) rotate(0deg); }
                to { transform: translate(-50%, -50%) rotate(360deg); }
            }

            .podcast-track-hit {
                padding: 0.4rem 0;
                margin: -0.25rem 0;
            }

            .festival-half-frame {
                overflow: hidden;
            }

            .festival-half-image {
                display: block;
                width: 200%;
                max-width: none;
                height: auto;
                max-height: none;
                object-fit: contain;
            }

            .festival-half-left {
                width: 100%;
                transform: none;
            }

            .festival-half-right {
                width: 100%;
                transform: none;
            }

            :global(.prose img) {
                border-radius: 1.75rem;
            }

            :global(.post-body) {
                font-size: 1.0625rem;
                line-height: 1.75;
            }

            :global(.post-body h2) {
                font-family: "Bricolage Grotesque", "Inter", sans-serif;
                font-weight: 800;
                font-size: 2rem;
                line-height: 1;
                letter-spacing: -0.03em;
                margin-top: 2.5em;
                margin-bottom: 0.75em;
            }

            :global(.post-body > h2:first-child) {
                margin-top: 0;
            }
        </style>
    </body>
</html>
