---
import { getCollection } from "astro:content";
import Meta from "@/components/meta.astro";
import ThemeToggle from "@/components/theme-toggle.astro";
import LanguageToggle from "@/components/language-toggle.astro";
import { useTranslations, formation, enBref, type Lang } from "@/i18n/ui";
import dayjs from "dayjs";
import fs from "node:fs";
import path from "node:path";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = await getCollection(lang === "en" ? "postsEn" : "posts");
const sortedProjects = posts.sort((a, b) =>
    dayjs(a.data.createdAt).isAfter(dayjs(b.data.createdAt)) ? -1 : 1,
);

const projectsRoot = path.join(process.cwd(), "public", "projects");
const imageExt = new Set([".png", ".jpg", ".jpeg", ".webp", ".svg"]);

const norm = (value: string) =>
    value
        .normalize("NFD")
        .replace(/\p{M}/gu, "")
        .replace(/\.mdx?$/i, "")
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, " ")
        .trim();

const projectDirs = fs.existsSync(projectsRoot)
    ? fs
          .readdirSync(projectsRoot, { withFileTypes: true })
          .filter((d) => d.isDirectory())
          .map((d) => d.name)
    : [];

const findProjectDir = (title: string, slug: string) => {
    const titleKey = norm(title);
    const slugKey = norm(slug);
    return (
        projectDirs.find((dir) => {
            const dirKey = norm(dir);
            return dirKey === titleKey || dirKey === slugKey;
        }) ?? null
    );
};

const coverBySlug = new Map<string, string>();
const preferredHomeCoverBySlug = new Map<string, string>([
    ["nakagin-capsule", "cover.jpg"],
]);
for (const project of sortedProjects) {
    const dir = findProjectDir(project.data.title, project.slug);
    if (!dir) continue;
    const projectDirPath = path.join(projectsRoot, dir);
    const files = fs.readdirSync(projectDirPath);
    const preferred = preferredHomeCoverBySlug.get(project.slug);
    const cover =
        (preferred && files.includes(preferred) && preferred) ||
        files.find(
            (f) =>
                /^cover\./i.test(f) &&
                imageExt.has(path.extname(f).toLowerCase()),
        );
    if (!cover) continue;
    const coverPath = path.join(projectDirPath, cover);
    const version = fs.statSync(coverPath).mtimeMs.toFixed(0);
    coverBySlug.set(
        project.slug,
        `/projects/${encodeURIComponent(dir)}/${encodeURIComponent(cover)}?v=${version}`,
    );
}

const popColors = ["yellow", "pink", "cyan", "red"] as const;
---

<html lang={lang}>
    <head>
        <!-- Language before paint: follow the system language from the root only -->
        <script is:inline>
            (function () {
                var path = location.pathname.replace(/\/+$/, "") || "/";
                if (path === "/en") return;
                var lang = null;
                try {
                    lang = localStorage.getItem("lang");
                } catch (e) {}
                if (lang !== "fr" && lang !== "en") {
                    var nav =
                        (navigator.languages && navigator.languages[0]) ||
                        navigator.language ||
                        "";
                    lang = /^fr/i.test(nav) ? "fr" : "en";
                }
                if (lang === "en") {
                    location.replace("/en");
                }
            })();
        </script>
        <Meta
            title={t("meta.title")}
            description={t("meta.description")}
            lang={lang}
            alternates={{ fr: "/", en: "/en" }}
        />
    </head>
    <body
        class="font-body min-h-screen bg-[var(--bg)] text-[var(--fg)] antialiased"
    >
        <header
            id="top-nav"
            class="top-nav fixed left-0 right-0 top-0 z-30 hidden px-6 py-4 md:px-12"
        >
            <div class="relative flex items-center justify-between">
                <a href="#home" class="nav-logo inline-flex items-center">
                    <img
                        src="/favicon1.svg"
                        alt="Logo Aliénor"
                        class="nav-logo-img h-10 w-10 object-contain md:h-12 md:w-12"
                    />
                </a>
                <nav class="absolute left-1/2 -translate-x-1/2">
                    <ul class="nav-pills flex items-center gap-1 text-sm font-semibold md:gap-2">
                        <li>
                            <a
                                class="module-tab nav-item"
                                data-target="portfolio"
                                href="#portfolio">{t("nav.portfolio")}</a
                            >
                        </li>
                        <li>
                            <a
                                class="module-tab nav-item"
                                data-target="profil"
                                href="#profil">{t("nav.profil")}</a
                            >
                        </li>
                        <li>
                            <a
                                class="module-tab nav-item"
                                data-target="contact"
                                href="#contact">{t("nav.contact")}</a
                            >
                        </li>
                    </ul>
                </nav>
                <div class="theme-dock">
                    <LanguageToggle lang={lang} />
                    <ThemeToggle />
                </div>
            </div>
        </header>

        <main class="relative overflow-x-clip bg-[var(--bg)]">
            <section
                id="home"
                data-section="home"
                class="relative flex min-h-[92svh] flex-col justify-center px-5 pb-28 pt-20 md:px-12"
            >
                <svg
                    class="sparkle sparkle-spin pointer-events-none absolute right-[6%] top-[12%] h-28 w-28 md:h-52 md:w-52"
                    viewBox="0 0 100 100"
                    aria-hidden="true"
                >
                    <path d="M50 0C54 34 66 46 100 50C66 54 54 66 50 100C46 66 34 54 0 50C34 46 46 34 50 0Z" fill="var(--pop-red)" />
                </svg>
                <svg
                    class="sparkle pointer-events-none absolute bottom-[26%] right-[22%] hidden h-14 w-14 md:block"
                    viewBox="0 0 100 100"
                    aria-hidden="true"
                >
                    <path d="M50 0C54 34 66 46 100 50C66 54 54 66 50 100C46 66 34 54 0 50C34 46 46 34 50 0Z" fill="var(--pop-pink)" />
                </svg>
                <div class="relative z-10 flex flex-col gap-6">
                    <img
                        src="/favicon1.svg"
                        alt="Logo Aliénor"
                        class="logo-red h-16 w-16 object-contain md:h-20 md:w-20"
                    />
                    <h1 class="font-title text-[19vw] leading-[0.82] text-[var(--fg)] md:text-[12vw]">
                        Aliénor<br />
                        <span class="font-script text-[0.9em] leading-none">du</span> Parc
                    </h1>
                    <div class="mt-2 flex flex-wrap items-center gap-3 text-sm md:text-lg">
                        <span class="sticker sticker-yellow -rotate-3">{t("hero.tagline")}</span>
                        <span class="sticker sticker-pink rotate-2">{sortedProjects.length} {t("hero.projects")}</span>
                        <span class="sticker sticker-cyan -rotate-1">FR · EN</span>
                    </div>
                </div>
                <nav
                    id="home-nav"
                    class="home-nav absolute bottom-8 left-0 right-0 z-20 px-5 md:px-12"
                >
                    <div class="relative flex items-center justify-between">
                        <a
                            href="#home"
                            class="nav-logo inline-flex items-center"
                        >
                            <img
                                src="/favicon1.svg"
                                alt="Logo Aliénor"
                                class="nav-logo-img h-10 w-10 object-contain md:h-12 md:w-12"
                            />
                        </a>
                        <div class="absolute left-1/2 -translate-x-1/2">
                            <ul class="nav-pills flex items-center gap-1 text-sm font-semibold md:gap-2">
                                <li>
                                    <a
                                        class="module-tab nav-item"
                                        data-target="portfolio"
                                        href="#portfolio">{t("nav.portfolio")}</a
                                    >
                                </li>
                                <li>
                                    <a
                                        class="module-tab nav-item"
                                        data-target="profil"
                                        href="#profil">{t("nav.profil")}</a
                                    >
                                </li>
                                <li>
                                    <a
                                        class="module-tab nav-item"
                                        data-target="contact"
                                        href="#contact">{t("nav.contact")}</a
                                    >
                                </li>
                            </ul>
                        </div>
                        <div class="theme-dock">
                            <LanguageToggle lang={lang} />
                            <ThemeToggle />
                        </div>
                    </div>
                </nav>
            </section>

            <section
                id="portfolio"
                data-section="portfolio"
                class="w-full px-5 py-20 md:px-12 md:py-28"
            >
                <div class="mb-12 flex flex-wrap items-end gap-4">
                    <h2 class="font-title text-6xl leading-[0.85] text-[var(--fg)] md:text-9xl">
                        {t("section.portfolio")}
                    </h2>
                    <span class="sticker sticker-red mb-2 rotate-3 text-sm md:text-base">2021 → 2025</span>
                </div>
                <div class="columns-1 gap-5 sm:columns-2 lg:columns-3">
                    {
                        sortedProjects.map((project, index) => {
                            const projectCover = coverBySlug.get(project.slug);
                            const color = popColors[index % popColors.length];
                            return (
                                <a
                                    href={`/${lang === "en" ? "en/" : ""}post/${project.slug}`}
                                    class="project-card group mb-8 block break-inside-avoid"
                                >
                                    {projectCover ? (
                                        <div class="overflow-hidden rounded-[1.75rem]">
                                            <img
                                                src={projectCover}
                                                alt={project.data.title}
                                                loading="lazy"
                                                class="project-card-img block h-auto w-full"
                                            />
                                        </div>
                                    ) : (
                                        <div class={`flex aspect-[4/5] w-full flex-col items-center justify-center gap-5 rounded-[1.75rem] px-8 text-center sticker-${color}`}>
                                            <img
                                                src="/favicon1.svg"
                                                alt=""
                                                aria-hidden="true"
                                                class="h-16 w-16 object-contain"
                                                style="filter: brightness(0) saturate(100%) invert(27%) sepia(24%) saturate(879%) hue-rotate(174deg) brightness(94%) contrast(90%);"
                                            />
                                            <p class="font-script text-5xl leading-[0.95] text-[var(--pop-ink)]">
                                                14 minutes et 16 heures
                                            </p>
                                        </div>
                                    )}
                                    <div class="mt-3 flex items-start justify-between gap-4 px-1">
                                        <h3 class="font-title text-xl leading-[1.05] md:text-2xl">
                                            {project.data.title}
                                        </h3>
                                        <span class={`sticker sticker-${color} shrink-0 text-xs tabular-nums`}>
                                            {dayjs(project.data.createdAt).format("YYYY")}
                                        </span>
                                    </div>
                                </a>
                            );
                        })
                    }
                </div>
            </section>

            <section
                id="profil"
                data-section="profil"
                class="w-full px-5 py-20 md:px-12 md:py-28"
            >
                <h2 class="font-title mb-12 text-6xl leading-[0.85] text-[var(--fg)] md:text-9xl">
                    {t("section.profil")}
                </h2>
                <div
                    class="grid gap-10 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] md:items-start md:gap-12"
                >
                    <article id="formation-content" class="p-0">
                        <h3 class="m-0 font-title text-3xl text-[var(--fg)]">
                            {t("section.formation")}
                        </h3>
                        <div
                            class="mt-5 space-y-5 text-sm leading-relaxed text-[var(--fg)]"
                        >
                            {
                                formation[lang].map((entry) => (
                                    <p>
                                        <span class="formation-date"
                                            >{entry.dates}</span
                                        ><br />
                                        {
                                            entry.lines.map((line, index) => (
                                                <>
                                                    {index > 0 && <br />}
                                                    {line}
                                                </>
                                            ))
                                        }
                                    </p>
                                ))
                            }
                        </div>
                    </article>

                    <div class="relative flex items-start justify-center">
                        <img
                            id="profil-photo"
                            src="/194135c7-391d-4556-9044-1ccea4404889.png"
                            alt={t("profil.photoAlt")}
                            class="w-full max-w-[300px] rounded-[2rem] object-cover md:w-[300px]"
                        />
                        <span class="sticker sticker-yellow absolute -bottom-4 left-1/2 -translate-x-1/2 -rotate-6 text-sm md:text-base">
                            Aliénor ✺
                        </span>
                    </div>

                    <article class="p-0">
                        <h3 class="m-0 font-title text-3xl text-[var(--fg)]">
                            {t("section.enBref")}
                        </h3>
                        <p
                            class="mt-5 text-sm leading-relaxed text-[var(--fg)]"
                            set:html={enBref[lang]}
                        ></p>
                    </article>
                </div>
            </section>

            <section
                id="contact"
                data-section="contact"
                class="w-full px-5 py-20 md:px-12 md:py-28"
            >
                <div class="contact-card relative overflow-hidden rounded-[2.5rem] px-6 py-14 md:px-14 md:py-24">
                    <svg
                        class="sparkle-spin pointer-events-none absolute -right-6 -top-6 h-32 w-32 md:h-56 md:w-56"
                        viewBox="0 0 100 100"
                        aria-hidden="true"
                    >
                        <path d="M50 0C54 34 66 46 100 50C66 54 54 66 50 100C46 66 34 54 0 50C34 46 46 34 50 0Z" fill="var(--pop-red)" />
                    </svg>
                    <h2 class="font-title relative text-6xl leading-[0.85] md:text-9xl">
                        {t("section.contact")}
                    </h2>
                    <a
                        href="mailto:alienor@duparc.studio"
                        class="contact-link font-script relative mt-8 inline-block break-all text-4xl md:text-7xl"
                        >alienor@duparc.studio</a
                    >
                </div>
            </section>
        </main>

        <script>
            const topNav = document.getElementById("top-nav");
            const homeNav = document.getElementById("home-nav");
            const homeSection = document.getElementById("home");
            const tabs =
                document.querySelectorAll<HTMLAnchorElement>(".module-tab");
            const contentSections = document.querySelectorAll<HTMLElement>(
                "#portfolio, #profil, #contact",
            );

            const updateActiveTab = (currentId) => {
                tabs.forEach((tab) => {
                    const isActive = tab.dataset.target === currentId;
                    tab.classList.toggle("is-active", isActive);
                });
            };

            const updateTopNavVisibility = () => {
                if (!topNav || !homeNav) return;
                const rect = homeNav.getBoundingClientRect();
                const dockLine = 10;
                const showTop = rect.top <= dockLine;
                topNav.classList.toggle("hidden", !showTop);
                homeNav.classList.toggle("invisible", showTop);
            };

            const updateSectionFromScroll = () => {
                const marker = window.innerHeight * 0.45;
                let currentId = "";

                contentSections.forEach((section) => {
                    const rect = section.getBoundingClientRect();
                    if (rect.top <= marker && rect.bottom > marker) {
                        currentId = section.id;
                    }
                });

                updateActiveTab(currentId);
            };

            window.addEventListener("scroll", updateSectionFromScroll, {
                passive: true,
            });
            window.addEventListener("resize", updateSectionFromScroll);
            window.addEventListener("scroll", updateTopNavVisibility, {
                passive: true,
            });
            window.addEventListener("resize", updateTopNavVisibility);
            updateSectionFromScroll();
            updateTopNavVisibility();

            const formationContent =
                document.getElementById("formation-content");
            const profilPhoto = document.getElementById("profil-photo");

            const alignProfilPhotoToFormation = () => {
                if (!formationContent || !profilPhoto) return;
                if (window.innerWidth < 768) {
                    profilPhoto.style.height = "auto";
                    return;
                }
                profilPhoto.style.height = `${formationContent.getBoundingClientRect().height}px`;
            };

            alignProfilPhotoToFormation();
            window.addEventListener("resize", alignProfilPhotoToFormation);
            if (formationContent) {
                new ResizeObserver(alignProfilPhotoToFormation).observe(
                    formationContent,
                );
            }
        </script>

        <style>
            html {
                scroll-behavior: smooth;
            }

            .nav-item {
                display: inline-block;
                border-radius: 999px;
                padding: 0.45rem 0.95rem;
                color: var(--fg);
                transition:
                    background-color 180ms ease,
                    color 180ms ease,
                    transform 180ms ease;
            }

            .nav-item:hover {
                background-color: var(--panel-bg);
                transform: rotate(-2deg);
            }

            .nav-item.is-active {
                background-color: var(--fg);
                color: var(--bg);
            }

            .nav-logo {
                transition:
                    opacity 180ms ease,
                    transform 180ms ease;
                opacity: 0.86;
            }

            .nav-logo:hover {
                opacity: 1;
                transform: translateY(-1px);
            }

            .nav-logo-img {
                filter: var(--logo-filter);
            }

            .top-nav {
                position: fixed;
                background: linear-gradient(
                    to bottom,
                    rgb(var(--bg-rgb) / 1) 0%,
                    rgb(var(--bg-rgb) / 1) 64%,
                    rgb(var(--bg-rgb) / 0.9) 74%,
                    rgb(var(--bg-rgb) / 0.74) 82%,
                    rgb(var(--bg-rgb) / 0.52) 89%,
                    rgb(var(--bg-rgb) / 0.28) 95%,
                    rgb(var(--bg-rgb) / 0) 100%
                );
                backdrop-filter: blur(8px);
                -webkit-backdrop-filter: blur(8px);
                min-height: 48px;
            }

            .top-nav::after {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                top: 0;
                bottom: -34px;
                background-image: radial-gradient(
                    rgba(255, 255, 255, 0.025) 0.7px,
                    transparent 0.7px
                );
                background-size: 3px 3px;
                opacity: 0.35;
                pointer-events: none;
            }

            .project-card {
                color: var(--fg);
                transition: transform 260ms cubic-bezier(0.3, 1.4, 0.5, 1);
            }

            .project-card:nth-child(odd):hover {
                transform: translateY(-6px) rotate(-1.2deg);
            }

            .project-card:nth-child(even):hover {
                transform: translateY(-6px) rotate(1.2deg);
            }

            .project-card-img {
                transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
            }

            .project-card:hover .project-card-img {
                transform: scale(1.04);
            }

            .contact-card {
                background: var(--pop-yellow);
                color: var(--pop-ink);
            }

            .contact-link {
                color: var(--pop-ink);
                text-decoration: underline;
                text-decoration-thickness: 2px;
                text-underline-offset: 0.12em;
                transition: color 180ms ease;
            }

            .contact-link:hover {
                color: var(--pop-red);
            }

            .sparkle-spin {
                animation: sparkleSpin 18s linear infinite;
            }

            @keyframes sparkleSpin {
                to {
                    transform: rotate(360deg);
                }
            }

            @media (prefers-reduced-motion: reduce) {
                .sparkle-spin {
                    animation: none;
                }
            }

            .logo-red {
                filter: var(--logo-filter);
            }

            .formation-date {
                font-size: 0.68rem;
                letter-spacing: 0.16em;
                text-transform: uppercase;
                color: var(--fg-88);
            }

            @media (max-width: 767px) {
                #home {
                    min-height: 78svh;
                }

                #home-nav {
                    bottom: max(0.75rem, env(safe-area-inset-bottom));
                    padding-left: 1rem;
                    padding-right: 1rem;
                }

                #home-nav .relative,
                #top-nav .relative {
                    justify-content: space-between;
                }

                #home-nav .theme-dock,
                #top-nav .theme-dock {
                    position: static;
                    transform: none;
                    gap: 0.5rem;
                }

                #home-nav .nav-logo,
                #top-nav .nav-logo {
                    display: none;
                }

                #home-nav .absolute,
                #top-nav nav {
                    position: static;
                    transform: none;
                }

                #home-nav ul,
                #top-nav ul {
                    gap: 0.125rem;
                    font-size: 0.8rem;
                }
            }
        </style>
    </body>
</html>
