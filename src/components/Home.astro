---
import { getCollection } from "astro:content";
import Meta from "@/components/meta.astro";
import ThemeToggle from "@/components/theme-toggle.astro";
import LanguageToggle from "@/components/language-toggle.astro";
import { useTranslations, formation, enBref, type Lang } from "@/i18n/ui";
import dayjs from "dayjs";
import fs from "node:fs";
import path from "node:path";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = await getCollection(lang === "en" ? "postsEn" : "posts");
const sortedProjects = posts.sort((a, b) =>
    dayjs(a.data.createdAt).isAfter(dayjs(b.data.createdAt)) ? -1 : 1,
);

const projectsRoot = path.join(process.cwd(), "public", "projects");
const imageExt = new Set([".png", ".jpg", ".jpeg", ".webp", ".svg"]);

const norm = (value: string) =>
    value
        .normalize("NFD")
        .replace(/\p{M}/gu, "")
        .replace(/\.mdx?$/i, "")
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, " ")
        .trim();

const projectDirs = fs.existsSync(projectsRoot)
    ? fs
          .readdirSync(projectsRoot, { withFileTypes: true })
          .filter((d) => d.isDirectory())
          .map((d) => d.name)
    : [];

const findProjectDir = (title: string, slug: string) => {
    const titleKey = norm(title);
    const slugKey = norm(slug);
    return (
        projectDirs.find((dir) => {
            const dirKey = norm(dir);
            return dirKey === titleKey || dirKey === slugKey;
        }) ?? null
    );
};

const coverBySlug = new Map<string, string>();
const preferredHomeCoverBySlug = new Map<string, string>([
    ["nakagin-capsule", "cover.jpg"],
]);
for (const project of sortedProjects) {
    const dir = findProjectDir(project.data.title, project.slug);
    if (!dir) continue;
    const projectDirPath = path.join(projectsRoot, dir);
    const files = fs.readdirSync(projectDirPath);
    const preferred = preferredHomeCoverBySlug.get(project.slug);
    const cover =
        (preferred && files.includes(preferred) && preferred) ||
        files.find(
            (f) =>
                /^cover\./i.test(f) &&
                imageExt.has(path.extname(f).toLowerCase()),
        );
    if (!cover) continue;
    const coverPath = path.join(projectDirPath, cover);
    const version = fs.statSync(coverPath).mtimeMs.toFixed(0);
    coverBySlug.set(
        project.slug,
        `/projects/${encodeURIComponent(dir)}/${encodeURIComponent(cover)}?v=${version}`,
    );
}

const thumbPositionBySlug = new Map<string, string>([
    ["podcast", "50% 24%"],
    ["entre-deux-corps", "50% 80%"],
    ["nakagin-capsule", "50% 50%"],
    ["structure-bois", "50% 60%"],
    ["chatel", "50% 50%"],
    ["festival--structure-temporaire", "50% 50%"],
    ["avenue-daumesnil", "50% 50%"],
    ["32-logements", "50% 68%"],
    ["ecole-sad", "50% 34%"],
    ["stage-simon-1", "50% 82%"],
    ["stage-chantier", "50% 56%"],
]);
---

<html lang={lang}>
    <head>
        <!-- Language before paint: follow the system language from the root only -->
        <script is:inline>
            (function () {
                var path = location.pathname.replace(/\/+$/, "") || "/";
                if (path === "/en") return;
                var lang = null;
                try {
                    lang = localStorage.getItem("lang");
                } catch (e) {}
                if (lang !== "fr" && lang !== "en") {
                    var nav =
                        (navigator.languages && navigator.languages[0]) ||
                        navigator.language ||
                        "";
                    lang = /^fr/i.test(nav) ? "fr" : "en";
                }
                if (lang === "en") {
                    location.replace("/en");
                }
            })();
        </script>
        <Meta
            title={t("meta.title")}
            description={t("meta.description")}
            lang={lang}
            alternates={{ fr: "/", en: "/en" }}
        />
    </head>
    <body
        class="font-body min-h-screen bg-[var(--bg)] text-[var(--fg)] antialiased"
    >
        <header
            id="top-nav"
            class="top-nav fixed left-0 right-0 top-0 z-30 hidden px-6 py-4 md:px-12"
        >
            <div class="relative flex items-center justify-between">
                <a href="#home" class="nav-logo inline-flex items-center">
                    <img
                        src="/favicon1.svg"
                        alt="Logo Aliénor"
                        class="nav-logo-img h-10 w-10 object-contain md:h-12 md:w-12"
                    />
                </a>
                <nav class="absolute left-1/2 -translate-x-1/2">
                    <ul
                        class="flex items-center gap-6 text-sm md:gap-10"
                    >
                        <li>
                            <a
                                class="module-tab nav-item"
                                data-target="portfolio"
                                href="#portfolio">{t("nav.portfolio")}</a
                            >
                        </li>
                        <li>
                            <a
                                class="module-tab nav-item"
                                data-target="profil"
                                href="#profil">{t("nav.profil")}</a
                            >
                        </li>
                        <li>
                            <a
                                class="module-tab nav-item"
                                data-target="contact"
                                href="#contact">{t("nav.contact")}</a
                            >
                        </li>
                    </ul>
                </nav>
                <div class="theme-dock">
                    <LanguageToggle lang={lang} />
                    <ThemeToggle />
                </div>
            </div>
        </header>

        <main class="relative bg-[var(--bg)]">
            <section
                id="home"
                data-section="home"
                class="relative flex min-h-[82svh] flex-col justify-center px-6 pb-28 pt-24 md:px-12"
            >
                <div class="relative z-10 flex max-w-5xl flex-col gap-8">
                    <img
                        src="/favicon1.svg"
                        alt="Logo Aliénor"
                        class="logo-red h-20 w-20 object-contain md:h-24 md:w-24"
                    />
                    <div>
                        <h1 class="font-title text-6xl leading-[0.95] text-[var(--fg)] md:text-8xl lg:text-9xl">
                            Aliénor du Parc
                        </h1>
                        <p class="mt-5 text-base text-[var(--fg-80)] md:text-xl">
                            {t("hero.tagline")}
                        </p>
                    </div>
                </div>
                <nav
                    id="home-nav"
                    class="home-nav absolute bottom-8 left-0 right-0 z-20 px-6 md:px-12"
                >
                    <div class="relative flex items-center justify-between">
                        <a
                            href="#home"
                            class="nav-logo inline-flex items-center"
                        >
                            <img
                                src="/favicon1.svg"
                                alt="Logo Aliénor"
                                class="nav-logo-img h-10 w-10 object-contain md:h-12 md:w-12"
                            />
                        </a>
                        <div class="absolute left-1/2 -translate-x-1/2">
                            <ul
                                class="flex items-center gap-6 text-sm md:gap-10"
                            >
                                <li>
                                    <a
                                        class="module-tab nav-item"
                                        data-target="portfolio"
                                        href="#portfolio">{t("nav.portfolio")}</a
                                    >
                                </li>
                                <li>
                                    <a
                                        class="module-tab nav-item"
                                        data-target="profil"
                                        href="#profil">{t("nav.profil")}</a
                                    >
                                </li>
                                <li>
                                    <a
                                        class="module-tab nav-item"
                                        data-target="contact"
                                        href="#contact">{t("nav.contact")}</a
                                    >
                                </li>
                            </ul>
                        </div>
                        <div class="theme-dock">
                            <LanguageToggle lang={lang} />
                            <ThemeToggle />
                        </div>
                    </div>
                </nav>
            </section>

            <section
                id="portfolio"
                data-section="portfolio"
                class="w-full border-t border-[var(--border-20)] px-6 py-20 md:px-12 md:py-28"
            >
                <h2 class="section-title font-title mb-12 text-4xl text-[var(--fg)] md:text-6xl">
                    {t("section.portfolio")}
                </h2>
                <div class="grid grid-cols-1 gap-x-8 gap-y-14 md:grid-cols-2">
                    {
                        sortedProjects.map((project) => {
                            const projectCover = coverBySlug.get(project.slug);
                            return (
                                <a
                                    href={`/${lang === "en" ? "en/" : ""}post/${project.slug}`}
                                    class="project-card group flex flex-col gap-4"
                                >
                                    <div class="relative aspect-[4/3] w-full overflow-hidden rounded-sm bg-[var(--panel-bg)]">
                                        {projectCover ? (
                                            <img
                                                src={projectCover}
                                                alt={project.data.title}
                                                loading="lazy"
                                                class="project-card-img h-full w-full object-cover"
                                                style={`object-position: ${thumbPositionBySlug.get(project.slug) ?? "50% 50%"};`}
                                            />
                                        ) : (
                                            <div class="flex h-full w-full items-center justify-center">
                                                <img
                                                    src="/favicon1.svg"
                                                    alt=""
                                                    aria-hidden="true"
                                                    class="logo-red h-16 w-16 object-contain opacity-60"
                                                />
                                            </div>
                                        )}
                                    </div>
                                    <div class="flex items-baseline justify-between gap-6">
                                        <h3 class="font-title text-xl leading-snug md:text-2xl">
                                            <span class="project-card-title">{project.data.title}</span>
                                        </h3>
                                        <p class="shrink-0 text-sm tabular-nums text-[var(--fg-70)]">
                                            {dayjs(project.data.createdAt).format("YYYY")}
                                        </p>
                                    </div>
                                </a>
                            );
                        })
                    }
                </div>
            </section>

            <section
                id="profil"
                data-section="profil"
                class="w-full border-t border-[var(--border-20)] px-6 py-20 md:px-12 md:py-28"
            >
                <h2 class="section-title font-title mb-12 text-4xl text-[var(--fg)] md:text-6xl">
                    {t("section.profil")}
                </h2>
                <div
                    class="grid gap-10 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] md:items-start md:gap-12"
                >
                    <article id="formation-content" class="p-0">
                        <h3 class="m-0 font-title text-2xl text-[var(--fg)]">
                            {t("section.formation")}
                        </h3>
                        <div
                            class="mt-5 space-y-5 text-sm leading-relaxed text-[var(--fg)]"
                        >
                            {
                                formation[lang].map((entry) => (
                                    <p>
                                        <span class="formation-date"
                                            >{entry.dates}</span
                                        ><br />
                                        {
                                            entry.lines.map((line, index) => (
                                                <>
                                                    {index > 0 && <br />}
                                                    {line}
                                                </>
                                            ))
                                        }
                                    </p>
                                ))
                            }
                        </div>
                    </article>

                    <div class="flex items-start justify-center">
                        <img
                            id="profil-photo"
                            src="/194135c7-391d-4556-9044-1ccea4404889.png"
                            alt={t("profil.photoAlt")}
                            class="w-full max-w-[300px] rounded-sm object-cover md:w-[300px]"
                        />
                    </div>

                    <article class="p-0">
                        <h3 class="m-0 font-title text-2xl text-[var(--fg)]">
                            {t("section.enBref")}
                        </h3>
                        <p
                            class="mt-5 text-sm leading-relaxed text-[var(--fg)]"
                            set:html={enBref[lang]}
                        ></p>
                    </article>
                </div>
            </section>

            <section
                id="contact"
                data-section="contact"
                class="flex min-h-[60svh] w-full flex-col border-t border-[var(--border-20)] px-6 py-20 md:px-12 md:py-28"
            >
                <h2 class="section-title font-title mb-12 text-4xl text-[var(--fg)] md:text-6xl">
                    {t("section.contact")}
                </h2>
                <a
                    href="mailto:alienor@duparc.studio"
                    class="contact-link font-title w-fit break-all text-3xl md:text-6xl"
                    >alienor@duparc.studio</a
                >
            </section>
        </main>

        <script>
            const topNav = document.getElementById("top-nav");
            const homeNav = document.getElementById("home-nav");
            const homeSection = document.getElementById("home");
            const tabs =
                document.querySelectorAll<HTMLAnchorElement>(".module-tab");
            const contentSections = document.querySelectorAll<HTMLElement>(
                "#portfolio, #profil, #contact",
            );

            const updateActiveTab = (currentId) => {
                tabs.forEach((tab) => {
                    const isActive = tab.dataset.target === currentId;
                    tab.classList.toggle("font-bold", isActive);
                    tab.classList.toggle("opacity-60", !isActive);
                });
            };

            const updateTopNavVisibility = () => {
                if (!topNav || !homeNav) return;
                const rect = homeNav.getBoundingClientRect();
                const dockLine = 10;
                const showTop = rect.top <= dockLine;
                topNav.classList.toggle("hidden", !showTop);
                homeNav.classList.toggle("invisible", showTop);
            };

            const updateSectionFromScroll = () => {
                const marker = window.innerHeight * 0.45;
                let currentId = "";

                contentSections.forEach((section) => {
                    const rect = section.getBoundingClientRect();
                    if (rect.top <= marker && rect.bottom > marker) {
                        currentId = section.id;
                    }
                });

                updateActiveTab(currentId);
            };

            window.addEventListener("scroll", updateSectionFromScroll, {
                passive: true,
            });
            window.addEventListener("resize", updateSectionFromScroll);
            window.addEventListener("scroll", updateTopNavVisibility, {
                passive: true,
            });
            window.addEventListener("resize", updateTopNavVisibility);
            updateSectionFromScroll();
            updateTopNavVisibility();

            const formationContent =
                document.getElementById("formation-content");
            const profilPhoto = document.getElementById("profil-photo");

            const alignProfilPhotoToFormation = () => {
                if (!formationContent || !profilPhoto) return;
                if (window.innerWidth < 768) {
                    profilPhoto.style.height = "auto";
                    return;
                }
                profilPhoto.style.height = `${formationContent.getBoundingClientRect().height}px`;
            };

            alignProfilPhotoToFormation();
            window.addEventListener("resize", alignProfilPhotoToFormation);
            if (formationContent) {
                new ResizeObserver(alignProfilPhotoToFormation).observe(
                    formationContent,
                );
            }
        </script>

        <style>
            html {
                scroll-behavior: smooth;
            }

            .module-tab {
                color: var(--fg);
                transition: opacity 180ms ease;
            }

            .nav-item {
                transition:
                    opacity 180ms ease,
                    font-weight 180ms ease,
                    color 180ms ease;
            }

            .nav-item:hover {
                font-weight: 700;
                color: var(--fg);
            }

            .nav-logo {
                transition:
                    opacity 180ms ease,
                    transform 180ms ease;
                opacity: 0.86;
            }

            .nav-logo:hover {
                opacity: 1;
                transform: translateY(-1px);
            }

            .nav-logo-img {
                filter: var(--logo-filter);
            }

            .top-nav {
                position: fixed;
                background: linear-gradient(
                    to bottom,
                    rgb(var(--bg-rgb) / 1) 0%,
                    rgb(var(--bg-rgb) / 1) 64%,
                    rgb(var(--bg-rgb) / 0.9) 74%,
                    rgb(var(--bg-rgb) / 0.74) 82%,
                    rgb(var(--bg-rgb) / 0.52) 89%,
                    rgb(var(--bg-rgb) / 0.28) 95%,
                    rgb(var(--bg-rgb) / 0) 100%
                );
                backdrop-filter: blur(8px);
                -webkit-backdrop-filter: blur(8px);
                min-height: 48px;
            }

            .top-nav::after {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                top: 0;
                bottom: -34px;
                background-image: radial-gradient(
                    rgba(255, 255, 255, 0.025) 0.7px,
                    transparent 0.7px
                );
                background-size: 3px 3px;
                opacity: 0.35;
                pointer-events: none;
            }

            .project-card {
                color: var(--fg);
            }

            .project-card-img {
                transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
            }

            .project-card:hover .project-card-img {
                transform: scale(1.03);
            }

            .project-card-title {
                background-image: linear-gradient(currentColor, currentColor);
                background-size: 0% 1px;
                background-repeat: no-repeat;
                background-position: 0 100%;
                transition: background-size 300ms ease;
            }

            .project-card:hover .project-card-title {
                background-size: 100% 1px;
            }

            .contact-link {
                color: var(--fg);
                text-decoration: underline;
                text-decoration-thickness: 1px;
                text-underline-offset: 0.18em;
                transition: opacity 180ms ease;
            }

            .contact-link:hover {
                opacity: 0.7;
            }

            .logo-red {
                filter: var(--logo-filter);
            }

            .formation-date {
                font-size: 0.68rem;
                letter-spacing: 0.16em;
                text-transform: uppercase;
                color: var(--fg-88);
            }

            @media (max-width: 767px) {
                #home {
                    min-height: 88svh;
                }

                #home-nav {
                    bottom: max(0.75rem, env(safe-area-inset-bottom));
                    padding-left: 1rem;
                    padding-right: 1rem;
                }

                #home-nav .relative,
                #top-nav .relative {
                    justify-content: space-between;
                }

                #home-nav .theme-dock,
                #top-nav .theme-dock {
                    position: static;
                    transform: none;
                    gap: 0.5rem;
                }

                #home-nav .nav-logo,
                #top-nav .nav-logo {
                    display: none;
                }

                #home-nav .absolute,
                #top-nav nav {
                    position: static;
                    transform: none;
                }

                #home-nav ul,
                #top-nav ul {
                    gap: 1.25rem;
                    font-size: 0.8rem;
                }
            }
        </style>
    </body>
</html>
