---
import { getCollection } from "astro:content";
import Meta from "@/components/meta.astro";
import ThemeToggle from "@/components/theme-toggle.astro";
import LanguageToggle from "@/components/language-toggle.astro";
import Starburst from "@/components/starburst.astro";
import Logo from "@/components/logo.astro";
import DuotoneFilters from "@/components/duotone-filters.astro";
import { themeForProject, duoFilter } from "@/components/poster-themes";
import { useTranslations, formation, enBref, type Lang } from "@/i18n/ui";
import dayjs from "dayjs";
import fs from "node:fs";
import path from "node:path";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = await getCollection(lang === "en" ? "postsEn" : "posts");
const sortedProjects = posts.sort((a, b) =>
    dayjs(a.data.createdAt).isAfter(dayjs(b.data.createdAt)) ? -1 : 1,
);

const projectsRoot = path.join(process.cwd(), "public", "projects");
const imageExt = new Set([".png", ".jpg", ".jpeg", ".webp", ".svg"]);

const norm = (value: string) =>
    value
        .normalize("NFD")
        .replace(/\p{M}/gu, "")
        .replace(/\.mdx?$/i, "")
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, " ")
        .trim();

const projectDirs = fs.existsSync(projectsRoot)
    ? fs
          .readdirSync(projectsRoot, { withFileTypes: true })
          .filter((d) => d.isDirectory())
          .map((d) => d.name)
    : [];

const findProjectDir = (title: string, slug: string) => {
    const titleKey = norm(title);
    const slugKey = norm(slug);
    return (
        projectDirs.find((dir) => {
            const dirKey = norm(dir);
            return dirKey === titleKey || dirKey === slugKey;
        }) ?? null
    );
};

const coverBySlug = new Map<string, string>();
const preferredHomeCoverBySlug = new Map<string, string>([
    ["nakagin-capsule", "cover.jpg"],
]);
for (const project of sortedProjects) {
    const dir = findProjectDir(project.data.title, project.slug);
    if (!dir) continue;
    const projectDirPath = path.join(projectsRoot, dir);
    const files = fs.readdirSync(projectDirPath);
    const preferred = preferredHomeCoverBySlug.get(project.slug);
    const cover =
        (preferred && files.includes(preferred) && preferred) ||
        files.find(
            (f) =>
                /^cover\./i.test(f) &&
                imageExt.has(path.extname(f).toLowerCase()),
        );
    if (!cover) continue;
    const coverPath = path.join(projectDirPath, cover);
    const version = fs.statSync(coverPath).mtimeMs.toFixed(0);
    coverBySlug.set(
        project.slug,
        `/projects/${encodeURIComponent(dir)}/${encodeURIComponent(cover)}?v=${version}`,
    );
}

---

<html lang={lang}>
    <head>
        <!-- Language before paint: follow the system language from the root only -->
        <script is:inline>
            (function () {
                var path = location.pathname.replace(/\/+$/, "") || "/";
                if (path === "/en") return;
                var lang = null;
                try {
                    lang = localStorage.getItem("lang");
                } catch (e) {}
                if (lang !== "fr" && lang !== "en") {
                    var nav =
                        (navigator.languages && navigator.languages[0]) ||
                        navigator.language ||
                        "";
                    lang = /^fr/i.test(nav) ? "fr" : "en";
                }
                if (lang === "en") {
                    location.replace("/en");
                }
            })();
        </script>
        <Meta
            title={t("meta.title")}
            description={t("meta.description")}
            lang={lang}
            alternates={{ fr: "/", en: "/en" }}
        />
    </head>
    <body
        class="font-body min-h-screen bg-[var(--bg)] text-[var(--fg)] antialiased"
    >
        <DuotoneFilters />
        <header
            id="top-nav"
            class="top-nav fixed left-0 right-0 top-0 z-30 hidden px-6 py-4 md:px-12"
        >
            <div class="relative flex items-center justify-between">
                <a href="#home" class="nav-logo inline-flex items-center">
                    <Logo withName />
                </a>
                <nav class="absolute left-1/2 -translate-x-1/2">
                    <ul class="flex items-center gap-1 font-wide text-[0.65rem] md:gap-2 md:text-xs">
                        <li>
                            <a
                                class="module-tab nav-item"
                                data-target="portfolio"
                                href="#portfolio">{t("nav.portfolio")}</a
                            >
                        </li>
                        <li>
                            <a
                                class="module-tab nav-item"
                                data-target="profil"
                                href="#profil">{t("nav.profil")}</a
                            >
                        </li>
                        <li>
                            <a
                                class="module-tab nav-item"
                                data-target="contact"
                                href="#contact">{t("nav.contact")}</a
                            >
                        </li>
                    </ul>
                </nav>
                <div class="theme-dock">
                    <LanguageToggle lang={lang} />
                    <ThemeToggle />
                </div>
            </div>
        </header>

        <main class="relative overflow-x-clip bg-[var(--bg)]">
            <section
                id="home"
                data-section="home"
                class="poster-hero sticky top-0 z-0 flex min-h-[100svh] flex-col px-4 pb-28 pt-5 md:px-8"
            >
                <div class="hero-fade relative z-10 flex items-start justify-between gap-6 font-wide text-[0.65rem] leading-tight md:text-xs">
                    <p>{t("meta.description")}<br />{t("hero.tagline")}</p>
                    <p class="text-right">duparc.studio<br />2021-2025</p>
                </div>
                <div class="relative flex flex-1 flex-col justify-center">
                    <div class="hero-burst pointer-events-none absolute inset-0 z-0">
                        <Starburst
                            fill="var(--pink)"
                            class="burst-spin-rev absolute left-[4%] top-[6%] h-[26vw] w-[26vw] md:left-[70%] md:top-[64%] md:h-[16vw] md:w-[16vw]"
                        />
                        <Starburst fill="var(--acid)" style="--burst-y: -50%" class="burst-spin absolute left-[38%] top-1/2 h-[62vw] w-[62vw] -translate-y-1/2 md:left-[42%] md:h-[44vw] md:w-[44vw]" />
                    </div>
                    <h1 class="hero-title font-title riso relative z-10 text-[27vw] leading-[0.8] text-[var(--blue)] md:text-[21vw]" style="--riso: var(--ink);">
                        <span class="block">Aliénor</span>
                        <span class="block pl-[9vw]">du Parc</span>
                    </h1>
                </div>
                <div class="hero-fade relative z-10 mb-4 flex items-end justify-end gap-6">
                    <p class="font-title text-right text-7xl leading-[0.8] text-[var(--acid)] md:text-[10rem]">
                        {String(sortedProjects.length).padStart(2, "0")}<span class="font-wide ml-2 align-top text-xs text-[var(--ink)] md:text-sm">{t("hero.projects")}</span>
                    </p>
                </div>
                <nav
                    id="home-nav"
                    class="home-nav absolute bottom-6 left-0 right-0 z-20 px-4 md:px-8"
                >
                    <div class="relative flex items-center justify-between">
                        <a
                            href="#home"
                            class="nav-logo inline-flex items-center"
                        >
                            <Logo withName />
                        </a>
                        <div class="absolute left-1/2 -translate-x-1/2">
                            <ul class="flex items-center gap-1 font-wide text-[0.65rem] md:gap-2 md:text-xs">
                                <li>
                                    <a
                                        class="module-tab nav-item"
                                        data-target="portfolio"
                                        href="#portfolio">{t("nav.portfolio")}</a
                                    >
                                </li>
                                <li>
                                    <a
                                        class="module-tab nav-item"
                                        data-target="profil"
                                        href="#profil">{t("nav.profil")}</a
                                    >
                                </li>
                                <li>
                                    <a
                                        class="module-tab nav-item"
                                        data-target="contact"
                                        href="#contact">{t("nav.contact")}</a
                                    >
                                </li>
                            </ul>
                        </div>
                        <div class="theme-dock">
                            <LanguageToggle lang={lang} />
                            <ThemeToggle />
                        </div>
                    </div>
                </nav>
            </section>

            <div id="sheet" class="sheet relative z-10 rounded-t-[2.5rem] bg-[var(--bg)] md:rounded-t-[3.5rem]">
            <section
                id="portfolio"
                data-section="portfolio"
                class="w-full px-4 py-20 md:px-8 md:py-28"
            >
                <h2 class="font-title riso mb-10 flex items-start text-[19vw] leading-[0.78] text-[var(--fg)] md:text-[16vw]" style="--riso: var(--violet);">
                    {t("section.portfolio")}
                    <span class="font-wide ml-3 mt-[1.2vw] text-sm text-[var(--violet)] [text-shadow:none] md:text-xl">({sortedProjects.length})</span>
                </h2>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {
                        sortedProjects.map((project, index) => {
                            const projectCover = coverBySlug.get(project.slug);
                            const theme = themeForProject(project.slug, index);
                            return (
                                <a
                                    href={`/${lang === "en" ? "en/" : ""}post/${project.slug}`}
                                    class="poster-card group relative flex flex-col overflow-hidden rounded-[1.5rem] p-3"
                                    style={`background: ${theme.bg}; color: ${theme.fg};`}
                                >
                                    <div
                                        class="duo relative aspect-[4/3] w-full overflow-hidden rounded-[1rem]"
                                        style={`--duo: ${duoFilter(theme.name)}; background: ${theme.dark};`}
                                    >
                                        {projectCover ? (
                                            <img
                                                src={projectCover}
                                                alt={project.data.title}
                                                loading="lazy"
                                                class="h-full w-full object-cover"
                                            />
                                        ) : (
                                            <p
                                                class="font-title flex h-full items-center justify-center px-6 text-center text-7xl leading-[0.85]"
                                                style={`color: ${theme.light};`}
                                            >
                                                14 min<br />16 h
                                            </p>
                                        )}
                                        {index % 3 === 0 && (
                                            <Starburst
                                                class="burst-card pointer-events-none absolute -right-8 -top-8 z-10 h-32 w-32"
                                                fill={theme.burst}
                                            />
                                        )}
                                    </div>
                                    <div class="flex flex-1 flex-col justify-between gap-6 px-1 pb-1 pt-4">
                                        <div class="flex items-start justify-between gap-4 font-wide text-[0.65rem]">
                                            <span>{String(index + 1).padStart(2, "0")}</span>
                                            <span class="text-right">{project.data.description.replace(/\.$/, "")}</span>
                                        </div>
                                        <div class="flex items-end justify-between gap-3">
                                            <h3 class="font-title riso text-4xl leading-[0.85] md:text-5xl" style={`--riso: ${theme.riso};`}>
                                                {project.data.title}
                                            </h3>
                                            <span class="font-title shrink-0 text-3xl leading-[0.8] md:text-4xl">
                                                {dayjs(project.data.createdAt).format("YY")}
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            );
                        })
                    }
                </div>
            </section>

            <section
                id="profil"
                data-section="profil"
                class="w-full px-4 py-20 md:px-8 md:py-28"
            >
                <h2 class="font-title riso mb-12 text-[22vw] leading-[0.78] text-[var(--fg)] md:text-[16vw]" style="--riso: var(--lime);">
                    {t("section.profil")}
                </h2>
                <div
                    class="grid gap-10 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] md:items-start md:gap-12"
                >
                    <article id="formation-content" class="p-0">
                        <h3 class="m-0 font-wide text-sm text-[var(--fg)]">
                            {t("section.formation")}
                        </h3>
                        <div
                            class="mt-5 space-y-5 text-sm leading-snug text-[var(--fg)]"
                        >
                            {
                                formation[lang].map((entry) => (
                                    <p>
                                        <span class="formation-date"
                                            >{entry.dates}</span
                                        ><br />
                                        {
                                            entry.lines.map((line, index) => (
                                                <>
                                                    {index > 0 && <br />}
                                                    {line}
                                                </>
                                            ))
                                        }
                                    </p>
                                ))
                            }
                        </div>
                    </article>

                    <div class="relative flex items-start justify-center">
                        <div class="duo w-full max-w-[320px] overflow-hidden rounded-[1.5rem] md:w-[320px]" style={`--duo: ${duoFilter("photo")};`}>
                            <img
                                id="profil-photo"
                                src="/194135c7-391d-4556-9044-1ccea4404889.png"
                                alt={t("profil.photoAlt")}
                                class="block w-full object-cover"
                            />
                        </div>
                        <Starburst
                            class="burst-spin pointer-events-none absolute -bottom-10 -right-6 h-28 w-28 md:-right-12"
                            fill="var(--acid)"
                        />
                    </div>

                    <article class="p-0">
                        <h3 class="m-0 font-wide text-sm text-[var(--fg)]">
                            {t("section.enBref")}
                        </h3>
                        <p
                            class="mt-5 text-sm leading-snug text-[var(--fg)]"
                            set:html={enBref[lang]}
                        ></p>
                    </article>
                </div>
            </section>


            <section
                id="contact"
                data-section="contact"
                class="w-full px-4 pb-8 pt-20 md:px-8 md:pt-28"
            >
                <div class="contact-card relative overflow-hidden rounded-[2rem] px-5 pb-8 pt-6 md:px-10 md:pb-12 md:pt-10">
                    <Starburst
                        class="burst-spin pointer-events-none absolute -right-16 -top-16 h-64 w-64 md:h-[28rem] md:w-[28rem]"
                        fill="var(--violet)"
                    />
                    <h2 class="font-title riso relative text-[24vw] leading-[0.78] md:text-[17vw]" style="--riso: var(--violet);">
                        {t("section.contact")}
                    </h2>
                    <a
                        href="mailto:alienor@duparc.studio"
                        class="contact-link font-wide relative mt-8 inline-block break-all text-lg md:text-4xl"
                        >alienor@duparc.studio ↗</a
                    >
                </div>
            </section>
            </div>
        </main>

        <script>
            const topNav = document.getElementById("top-nav");
            const homeNav = document.getElementById("home-nav");
            const homeSection = document.getElementById("home");
            const tabs =
                document.querySelectorAll<HTMLAnchorElement>(".module-tab");
            const contentSections = document.querySelectorAll<HTMLElement>(
                "#portfolio, #profil, #contact",
            );

            const updateActiveTab = (currentId) => {
                tabs.forEach((tab) => {
                    const isActive = tab.dataset.target === currentId;
                    tab.classList.toggle("is-active", isActive);
                });
            };

            const sheet = document.getElementById("sheet");

            const updateTopNavVisibility = () => {
                if (!topNav || !homeNav || !sheet) return;
                // La barre du haut apparaît quand la feuille de contenu recouvre l'accueil
                const showTop = sheet.getBoundingClientRect().top <= 72;
                topNav.classList.toggle("hidden", !showTop);
                homeNav.classList.toggle("invisible", showTop);
            };

            const updateSectionFromScroll = () => {
                const marker = window.innerHeight * 0.45;
                let currentId = "";

                contentSections.forEach((section) => {
                    const rect = section.getBoundingClientRect();
                    if (rect.top <= marker && rect.bottom > marker) {
                        currentId = section.id;
                    }
                });

                updateActiveTab(currentId);
            };

            window.addEventListener("scroll", updateSectionFromScroll, {
                passive: true,
            });
            window.addEventListener("resize", updateSectionFromScroll);
            window.addEventListener("scroll", updateTopNavVisibility, {
                passive: true,
            });
            window.addEventListener("resize", updateTopNavVisibility);
            updateSectionFromScroll();
            updateTopNavVisibility();

            const formationContent =
                document.getElementById("formation-content");
            const profilPhoto = document.getElementById("profil-photo");

            const alignProfilPhotoToFormation = () => {
                if (!formationContent || !profilPhoto) return;
                if (window.innerWidth < 768) {
                    profilPhoto.style.height = "auto";
                    return;
                }
                profilPhoto.style.height = `${formationContent.getBoundingClientRect().height}px`;
            };

            alignProfilPhotoToFormation();
            window.addEventListener("resize", alignProfilPhotoToFormation);
            if (formationContent) {
                new ResizeObserver(alignProfilPhotoToFormation).observe(
                    formationContent,
                );
            }
        </script>

        <style>
            html {
                scroll-behavior: smooth;
            }

            .nav-item {
                display: inline-block;
                border-radius: 999px;
                padding: 0.45rem 0.95rem;
                color: var(--fg);
                transition:
                    background-color 180ms ease,
                    color 180ms ease,
                    transform 180ms ease;
            }

            .nav-item:hover {
                background-color: var(--panel-bg);
                transform: rotate(-2deg);
            }

            .nav-item.is-active {
                background-color: var(--fg);
                color: var(--bg);
            }

            .poster-hero .nav-item.is-active {
                color: var(--acid);
            }

            .nav-logo {
                transition:
                    opacity 180ms ease,
                    transform 180ms ease;
                opacity: 0.86;
            }

            .nav-logo:hover {
                opacity: 1;
                transform: translateY(-1px);
            }

            .nav-logo {
                color: var(--fg);
                --logo-fill: var(--blue);
                --logo-riso: var(--pink);
                --logo-riso2: var(--acid);
            }


            .top-nav {
                position: fixed;
                background: linear-gradient(
                    to bottom,
                    rgb(var(--bg-rgb) / 1) 0%,
                    rgb(var(--bg-rgb) / 1) 64%,
                    rgb(var(--bg-rgb) / 0.9) 74%,
                    rgb(var(--bg-rgb) / 0.74) 82%,
                    rgb(var(--bg-rgb) / 0.52) 89%,
                    rgb(var(--bg-rgb) / 0.28) 95%,
                    rgb(var(--bg-rgb) / 0) 100%
                );
                backdrop-filter: blur(8px);
                -webkit-backdrop-filter: blur(8px);
                min-height: 48px;
            }

            .top-nav::after {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                top: 0;
                bottom: -34px;
                background-image: radial-gradient(
                    rgba(255, 255, 255, 0.025) 0.7px,
                    transparent 0.7px
                );
                background-size: 3px 3px;
                opacity: 0.35;
                pointer-events: none;
            }

            .poster-hero {
                --logo-fill: var(--blue);
                --logo-riso: var(--pink);
                --logo-riso2: var(--acid);
                --fg: #111111;
                --fg-70: rgba(17, 17, 17, 0.7);
                --fg-80: rgba(17, 17, 17, 0.8);
                --panel-bg: rgba(17, 17, 17, 0.1);
                --logo-filter: brightness(0);
                background: var(--violet);
                color: var(--ink);
            }

            .sheet {
                box-shadow: 0 -30px 80px rgb(0 0 0 / 0.12);
            }

            /* Transition : le nom fonce vers l'écran, les étoiles s'emballent, puis la feuille des projets monte */
            @supports (animation-timeline: scroll()) {
                .hero-title {
                    transform-origin: 45% 55%;
                    animation: heroZoom linear both;
                    animation-timeline: scroll(root);
                    animation-range: 0 85svh;
                }

                .hero-burst {
                    animation: heroBurst linear both;
                    animation-timeline: scroll(root);
                    animation-range: 0 100svh;
                }

                .hero-fade {
                    animation: heroFade linear both;
                    animation-timeline: scroll(root);
                    animation-range: 0 40svh;
                }

                .poster-card {
                    animation: cardIn linear both;
                    animation-timeline: view();
                    animation-range: entry 0% entry 70%;
                }

                @keyframes heroZoom {
                    to {
                        transform: scale(3.2);
                        opacity: 0;
                        filter: blur(6px);
                    }
                }

                @keyframes heroBurst {
                    to {
                        transform: rotate(120deg) scale(2.2);
                        opacity: 0.4;
                    }
                }

                @keyframes heroFade {
                    to {
                        opacity: 0;
                        transform: translateY(-2rem);
                    }
                }

                @keyframes cardIn {
                    from {
                        opacity: 0;
                        transform: translateY(80px) scale(0.94);
                    }
                }
            }

            @media (prefers-reduced-motion: reduce) {
                .hero-title,
                .hero-burst,
                .hero-fade,
                .poster-card {
                    animation: none;
                }
            }

            .poster-card {
                color: var(--ink);
                box-shadow: inset 0 0 0 1px rgb(var(--fg-rgb) / 0.12);
                transition: transform 300ms cubic-bezier(0.3, 1.5, 0.5, 1);
            }

            .poster-card:hover {
                transform: translateY(-4px);
            }

            .poster-card:hover .duo img {
                filter: none;
                mix-blend-mode: normal;
                transform: scale(1.04);
            }

            .poster-card:hover .duo::after {
                opacity: 0;
            }

            .burst-card {
                transition: transform 500ms cubic-bezier(0.3, 1.5, 0.5, 1);
            }

            .poster-card:hover .burst-card {
                transform: rotate(35deg) scale(1.15);
            }

            .contact-card {
                background: var(--blue);
                color: var(--pink);
            }

            .contact-link {
                text-decoration: underline;
                text-decoration-thickness: 2px;
                text-underline-offset: 0.18em;
                transition: color 180ms ease;
            }

            .contact-link:hover {
                color: var(--acid);
            }

            .burst-spin {
                animation: burstSpin 40s linear infinite;
            }

            .burst-spin-rev {
                animation: burstSpin 28s linear infinite reverse;
            }

            @keyframes burstSpin {
                to {
                    transform: translateY(var(--burst-y, 0)) rotate(360deg);
                }
            }

            @media (prefers-reduced-motion: reduce) {
                .burst-spin,
                .burst-spin-rev {
                    animation: none;
                }
            }


            .formation-date {
                font-family: "Archivo", "Inter", sans-serif;
                font-weight: 800;
                font-stretch: 125%;
                font-size: 0.65rem;
                text-transform: uppercase;
                color: var(--violet);
            }

            @media (max-width: 767px) {
                #home {
                    min-height: 78svh;
                }

                #home-nav {
                    bottom: max(0.75rem, env(safe-area-inset-bottom));
                    padding-left: 1rem;
                    padding-right: 1rem;
                }

                #home-nav .relative,
                #top-nav .relative {
                    justify-content: space-between;
                }

                #home-nav .theme-dock,
                #top-nav .theme-dock {
                    position: static;
                    transform: none;
                    gap: 0.5rem;
                }

                #home-nav .nav-logo,
                #top-nav .nav-logo {
                    display: none;
                }

                #home-nav .absolute,
                #top-nav nav {
                    position: static;
                    transform: none;
                }

                #home-nav ul,
                #top-nav ul {
                    gap: 0;
                    font-size: 0.58rem;
                }

                #home-nav .nav-item,
                #top-nav .nav-item {
                    padding: 0.4rem 0.5rem;
                }
            }
        </style>
    </body>
</html>
