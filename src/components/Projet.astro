---
import Jour from "@/components/Jour.astro";
import Logo from "@/components/Logo.astro";
import { accueil, esc, jeu, opt, pagesEn, partage, prefixe, VEDETTE, type Image, type Lang } from "@/data/site";
import { traduction } from "@/i18n/ui";
import Base from "@/layouts/Base.astro";
import { disque } from "@/scripts/formes.js";
import "@/styles/projet.css";

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = traduction(lang);
const PAGES = pagesEn(lang);
const rang = PAGES.findIndex((x) => x.slug == slug), P = PAGES[rang], SUITE = PAGES[(rang + 1) % PAGES.length];
const preDe = (im: Image) => (im.trait ? "url(#trait)" : im.sombre ? "brightness(2.2)" : "");
const fig = (im: Image, st: string, tete?: boolean) => `<button class="fig${im.libre ? " libre" : ""}${im.rond ? " rond" : ""}${im.flotte ? " flotte" : ""}" style="${st}" data-src="${im.s}" aria-label="${t("agrandir")}"><span class="w" style="aspect-ratio:${im.w}/${im.h}"><img class="im" ${tete ? 'fetchpriority="high"' : 'loading="lazy"'} decoding="async" src="${opt(im.s, 800)}" srcset="${jeu(im.s)}" sizes="${tete ? VEDETTE : "(max-width:900px) 100vw,60vw"}" alt="${esc(P.titre)}" style="--pre:${preDe(im)}"></span></button>`;
// Les images sont groupées avec les phrases de la section la plus découpée
const secs = P.sections, tisse = secs.reduce((m, x) => (x.l.length > m.l.length ? x : m), secs[0]);
const MOTIF = [{ i: "1/span 8", l: "9/span 4" }, { i: "6/span 7", l: "2/span 4" }, { i: "2/span 6", l: "9/span 4" }, { i: "5/span 8", l: "1/span 4" }];
const grille = (x: (typeof secs)[number]) => {
  if (x != tisse || !P.images.length) return `<div class="long">${x.l.map((l) => `<p>${esc(l)}</p>`).join("")}</div>`;
  const n = P.images.length, tranche = Math.ceil(x.l.length / n);
  let o = "";
  P.images.forEach((im: Image, k: number) => {
    const m = MOTIF[k % MOTIF.length], debout = im.h > im.w * 1.05, lignes = x.l.slice(k * tranche, (k + 1) * tranche);
    const carre = im.rond, st = debout ? `grid-column:${k % 2 ? "7" : "2"}/span 5` : carre ? "grid-column:1/span 6" : `grid-column:${m.i}`, ls = debout ? `grid-column:${k % 2 ? "2/span 4" : "8/span 4"}` : carre ? "grid-column:7/span 6" : `grid-column:${m.l}`;
    const a = fig(im, st), b = lignes.length ? `<div class="lignes" style="${ls}">${lignes.map((l) => `<p>${esc(l)}</p>`).join("")}</div>` : "";
    o += k % 2 ? b + a : a + b;
  });
  return o;
};
const court = (h: string) => h.replace(" du projet", "").replace(/^Project s/, "S");
// Le haut de page ; chaque disque a sa graine, selon son ordre dans la page
let graine = rang * 5 + 3;
const d = (attr: string, bleu = false) => `<div ${attr}>${disque(graine++, bleu)}</div>`;
const disques = d(`class="d" style="width:${11 + (rang % 5) * 1.6}vw;height:${11 + (rang % 5) * 1.6}vw;left:${rang % 2 ? 20 : 24}%;top:${rang % 2 ? 3 : 4}%"`) + d(`class="d db" style="width:3.4vw;height:3.4vw;left:${rang % 2 ? 8 : 12}%;top:${rang % 2 ? 30 : 24}%"`, true);
const boite = () => `<a class="boite" href="${P.lien}" aria-label="${t("ouvrirA")}"><span class="carton"><span class="cote"></span><span class="dessus"></span><span class="rabat"><i class="etiquette">${esc(P.etiquette)}</i></span></span><span class="legende">${t("ouvrir")}</span></a>`;
const haut = P.dossier == "ivresse" ? `<a class="livre" href="${prefixe(lang)}/livre/ivresse?from=projet" aria-label="${t("lireA")}"><span class="tome"><span class="tranche"></span><span class="face"><em>14 minutes et 16 heures</em><span class="d">${disque(graine++, false)}</span><small>Aliénor du Parc</small></span></span><span class="legende">${t("lire")}</span></a>` : P.lien ? boite() : P.cover ? fig(P.cover, "", true) : `<div class="vide">Coming soon</div>`;
const ecoute = P.dossier == "Podcast" ? `<section class="grille lecteur"><div class="carte"><img src="/opt/Podcast.mdx/profil-800.webp" alt="${esc(t("pochette"))}"><div><strong>Double Vision : Architecture Abroad</strong><small>Aliénor Knoll &amp; Aliénor du Parc</small><div class="barre"><button class="lire" id="lire" aria-label="${esc(t("lecture"))}"><span id="ico">▶</span></button><span id="tps">00:00</span><input id="pos" type="range" min="0" max="1000" value="0" aria-label="${esc(t("pos"))}"><span id="dur">00:00</span></div></div><audio id="son" preload="metadata" src="/projects/Podcast.mdx/podcats.mp3"></audio></div></section>` : "";
const imSuite = SUITE.cover ? (SUITE.images[0] && SUITE.cover.libre ? SUITE.images[0] : SUITE.cover) : null;
const pochette = imSuite ? `<img class="im" loading="lazy" decoding="async" src="${opt(imSuite.s, 800)}" alt="" style="--pre:${preDe(imSuite)}">` : "";
const preSuite = SUITE.dossier != "ivresse" && !SUITE.lien && SUITE.cover ? ` data-jeu="${jeu(SUITE.cover.s)}" data-tailles="${VEDETTE}"` : "";
const contenu = `<section class="ouv">${disques}
  <div class="vedette">${haut}</div>
  <div class="tete"><b>${P.no}</b><h1>${esc(P.titre)}</h1><p>${esc(P.an)}${P.meta ? " - " + esc(P.meta) : ""}</p>${P.etat ? `<p class="etat">${esc(P.etat)}</p>` : ""}</div></section>${ecoute}
  ${secs.map((x, k) => `<section class="grille" id="e${k}"><h2>${esc(x.h)}</h2>${grille(x)}</section>`).join("")}
  <section class="suite" id="esuite"><a href="${SUITE.url}"${preSuite}><span class="w">${pochette}</span><span><small>${t("suivant")}</small><h2>${esc(SUITE.titre)}</h2></span><span class="f" aria-hidden="true">→</span></a></section>`;
const ET: [string, string][] = [...secs.map((x, k): [string, string] => ["e" + k, court(x.h)]), ["esuite", t("suivant")]];
const lot = [P.cover, ...P.images].filter(Boolean).map((im: Image) => ({ s: im.s, u: opt(im.s, 2400), pre: preDe(im) }));
const texte = secs[0]?.l[0] || "";
const description = [`${P.an}${P.meta ? " - " + P.meta : ""}`, texte].filter(Boolean).join(". ").slice(0, 200);
---

<Base title={`${P.titre} | Aliénor du Parc`} description={description} lang={lang} chemin={`/post/${P.slug}`} image={partage(P.couverture)} attributs={{ "data-rang": rang }}>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="trait" color-interpolation-filters="sRGB"><feComponentTransfer><feFuncR type="gamma" exponent="3.2"></feFuncR><feFuncG type="gamma" exponent="3.2"></feFuncG><feFuncB type="gamma" exponent="3.2"></feFuncB></feComponentTransfer></filter><filter id="bleu" color-interpolation-filters="sRGB"><feColorMatrix type="saturate" values="0"></feColorMatrix><feComponentTransfer><feFuncR type="linear" slope="1.3" intercept="-.13"></feFuncR><feFuncG type="linear" slope="1.3" intercept="-.13"></feFuncG><feFuncB type="linear" slope="1.3" intercept="-.13"></feFuncB></feComponentTransfer><feComponentTransfer><feFuncR type="table" tableValues=".145 .937"></feFuncR><feFuncG type="table" tableValues=".17 .914"></feFuncG><feFuncB type="table" tableValues=".5 .867"></feFuncB></feComponentTransfer></filter><filter id="nuit-sable" color-interpolation-filters="sRGB"><feColorMatrix type="saturate" values="0"></feColorMatrix><feComponentTransfer><feFuncR type="table" tableValues=".078 .36 .78"></feFuncR><feFuncG type="table" tableValues=".086 .35 .74"></feFuncG><feFuncB type="table" tableValues=".18 .36 .65"></feFuncB></feComponentTransfer></filter></svg>
  <a class="haut gauche" id="maison" data-logo href={accueil(lang)} aria-label={t("accueil")}><Logo /></a>
  <ol class="etapes" id="etapes" aria-label={t("etapes")}>
    {ET.map(([id, nom], k) => <li><a href={`#${id}`} data-e={id}>{nom}<b>{k + 1}</b></a></li>)}
  </ol>
  <Jour lang={lang} chemin={`/post/${P.slug}`} />
  <div id="page">
    <svg id="champ" aria-hidden="true"></svg>
    <svg id="couche" aria-hidden="true"><g id="gras" fill="none" stroke-linecap="round" style="stroke:var(--r)"></g></svg>
    <main id="contenu" set:html={contenu}></main>
  </div>
  <div id="loupe" role="dialog" aria-modal="true" aria-label={t("loupe")} data-lot={JSON.stringify(lot)}>
    <button class="x" aria-label={t("fermer")}>×</button>
    <button class="tourne" aria-label={t("tourner")}>↻</button>
    <button class="g" aria-label={t("prec")}>‹</button>
    <button class="dr" aria-label={t("suiv")}>›</button>
    <img class="im" alt="" />
  </div>
  <script>
    import "@/scripts/projet.js";
  </script>
</Base>
