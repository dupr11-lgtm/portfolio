---
import "../styles/globals.css";
import type { Lang } from "@/i18n/ui";

interface Props {
  title: string;
  description: string;
  slug?: string;
  lang: Lang;
  alternates?: { fr: string; en: string };
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const defaultShareImage = new URL("/social-preview-v3.png?v=3", Astro.url);

const { title, description, slug, lang, alternates } = Astro.props;
const locale = lang === "fr" ? "fr_FR" : "en_US";
const otherLocale = lang === "fr" ? "en_US" : "fr_FR";
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon2.png" />
<link rel="icon" type="image/svg+xml" href="/favicon-blue.svg" data-theme-fav />
<link rel="apple-touch-icon" href="/favicon2.png" />
<meta name="generator" content={Astro.generator} />
<link rel="sitemap" href="/sitemap.xml" />

<!-- Theme before paint -->
<script is:inline>
    (function () {
        var theme = null;
        try {
            theme = localStorage.getItem("theme");
        } catch (e) {}
        if (theme !== "dark" && theme !== "light") {
            theme =
                window.matchMedia &&
                window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light";
        }
        document.documentElement.classList.add("theme-" + theme);
        window.__applyFavicon = function (t) {
            var fav = document.querySelector('link[rel="icon"][data-theme-fav]');
            if (fav) {
                fav.href =
                    t === "dark" ? "/favicon-white.svg" : "/favicon-blue.svg";
            }
        };
        window.__applyFavicon(theme);
    })();
</script>

<!-- Umami Analytics -->
<script defer src="https://u.herbievine.com/script.js" data-website-id="db8d3099-07fb-4913-9489-e87067418f74"></script>

<!-- Font preloads -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&display=swap" rel="stylesheet">

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Alternate languages -->
{
    alternates && (
        <>
            <link rel="alternate" hreflang="fr" href={new URL(alternates.fr, Astro.site)} />
            <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site)} />
            <link rel="alternate" hreflang="x-default" href={new URL(alternates.fr, Astro.site)} />
        </>
    )
}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={locale} />
<meta property="og:locale:alternate" content={otherLocale} />
<meta property="og:image" content={slug ? new URL(slug, Astro.url) : defaultShareImage} />
<meta property="og:image:secure_url" content={slug ? new URL(slug, Astro.url) : defaultShareImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Alienor">

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={slug ? new URL(slug, Astro.url) : defaultShareImage} />
<meta property="twitter:image:width" content="1200">
<meta property="twitter:image:height" content="630">
<meta property="twitter:image:alt" content="Alienor">

<!-- Robots -->
<meta name="robots" content="index, follow">
<meta name="googlebot" content="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1">
