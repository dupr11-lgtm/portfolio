---
interface Props {
    class?: string;
    withName?: boolean;
}

const { class: className = "", withName = false } = Astro.props;
---

<span class={`logo-lockup inline-flex items-center gap-3 ${className}`}>
    <span class="logo-badge relative inline-flex h-11 w-11 shrink-0 items-center justify-center md:h-12 md:w-12">
        <svg class="logo-seal absolute inset-0 h-full w-full" viewBox="0 0 100 100" aria-hidden="true">
            <path d="M50.0 0.0 L57.6 11.7 L69.1 3.8 L71.7 17.6 L85.4 14.6 L82.4 28.3 L96.2 30.9 L88.3 42.4 L100.0 50.0 L88.3 57.6 L96.2 69.1 L82.4 71.7 L85.4 85.4 L71.7 82.4 L69.1 96.2 L57.6 88.3 L50.0 100.0 L42.4 88.3 L30.9 96.2 L28.3 82.4 L14.6 85.4 L17.6 71.7 L3.8 69.1 L11.7 57.6 L0.0 50.0 L11.7 42.4 L3.8 30.9 L17.6 28.3 L14.6 14.6 L28.3 17.6 L30.9 3.8 L42.4 11.7Z" fill="var(--red)"></path>
        </svg>
        <span class="font-title relative text-[0.95rem] leading-none text-[var(--paper)] md:text-[1.05rem]" aria-hidden="true">ADP</span>
    </span>
    {
        withName ? (
            <span class="font-wide text-[0.6rem] leading-[1.15] md:text-[0.7rem]">
                Aliénor
                <br />
                du Parc
            </span>
        ) : (
            <span class="sr-only">Aliénor du Parc</span>
        )
    }
</span>

<style>
    .logo-seal {
        transition: transform 600ms cubic-bezier(0.3, 1.5, 0.5, 1);
    }

    :global(a:hover) .logo-seal {
        transform: rotate(45deg);
    }
</style>
