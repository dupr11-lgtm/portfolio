---
import fs from "node:fs";
import path from "node:path";

interface Props {
    class?: string;
    withName?: boolean;
}

const { class: className = "", withName = false } = Astro.props;

// La maison d'origine, redessinée façon impression riso : un calque décalé en couleur sous le trait
const houseSvg = fs.readFileSync(path.join(process.cwd(), "public", "favicon1.svg"), "utf8");
const housePath = houseSvg.match(/ d="([^"]+)"/)?.[1] ?? "";
---

<span class={`logo-lockup inline-flex items-center gap-2.5 ${className}`}>
    <svg class="logo-house h-11 w-auto shrink-0 md:h-12" viewBox="80 80 900 1290" aria-hidden="true">
        <path class="logo-house-riso" d={housePath} fill-rule="evenodd"></path>
        <path d={housePath} fill-rule="evenodd" fill="currentColor"></path>
    </svg>
    {
        withName ? (
            <span class="font-wide text-[0.6rem] leading-[1.15] md:text-[0.7rem]">
                Aliénor
                <br />
                du Parc
            </span>
        ) : (
            <span class="sr-only">Aliénor du Parc</span>
        )
    }
</span>

<style>
    .logo-house-riso {
        fill: var(--logo-riso, var(--red));
        transform: translate(46px, 30px);
        transition: transform 300ms cubic-bezier(0.3, 1.5, 0.5, 1);
    }

    :global(a:hover) .logo-house-riso {
        transform: translate(90px, 60px);
    }
</style>
